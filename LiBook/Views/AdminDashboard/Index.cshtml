﻿@{
    ViewData["Title"] = "Admin Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - LiBook</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@100..900&family=League+Spartan:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="~/Content/admindashboard.css" rel="stylesheet" />
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <svg class="logo-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15 15">
                    <path fill="currentColor" d="M1.082 9.939C.987 9.867 1 9.748 1 9.748L1.526 3.5s.008-.069.039-.104c.019-.022.043-.054.09-.073C2.182 3.107 5.053 1.552 6.5 3c.24.278.5.688.5 1v5.288s.006.112-.095.18a.25.25 0 0 1-.242.003c-2.226-1.114-4.711.154-5.338.487a.22.22 0 0 1-.243-.02m12.593.019c-.627-.333-3.112-1.6-5.338-.487a.25.25 0 0 1-.242-.003C7.994 9.4 8 9.288 8 9.288V4c0-.312.26-.722.5-1c1.446-1.448 4.3.107 4.827.323c.046.019.07.051.09.073c.03.035.039.104.039.104l.543 6.248s.014.119-.08.19a.22.22 0 0 1-.244.02m-4.81 2.728a.24.24 0 0 0 .118-.077a.2.2 0 0 0 .042-.109c.05-.938 1.624-1.812 4.648-.03c.077.044.166.04.242-.015c.086-.063.085-.17.085-.17v-.553s0-.077-.027-.119a.23.23 0 0 0-.093-.085c-2.025-1.315-4.586-1.898-5.885-.16a.2.2 0 0 1-.073.09c-.057.045-.126.042-.126.042h-.585s-.07.003-.126-.041a.2.2 0 0 1-.073-.09c-1.3-1.739-3.86-1.184-5.885.131a.23.23 0 0 0-.093.086c-.027.042-.027.118-.027.118v.554s-.001.107.085.17a.22.22 0 0 0 .243.015c3.023-1.782 4.598-.88 4.647.057a.2.2 0 0 0 .043.109a.24.24 0 0 0 .118.077c.721.18 1.768.25 2.722 0" />
                </svg>
                <h2 class="logo">Li<span>Book</span></h2>
            </div>
            <button class="close-btn" id="closeSidebar">
                <i class="fas fa-times"></i>
            </button>
            <button class="menu-toggle-sidebar desktop-only" id="sidebarToggleDesktop">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <nav class="sidebar-nav">
            <a href="@Url.Action("Index", "AdminDashboard")" class="nav-item active" data-page="dashboard">
                <i class="fas fa-home"></i>
                <span>Dashboard</span>
            </a>
            <a href="@Url.Action("Reservations", "AdminDashboard")" class="nav-item" data-page="reservations">
                <i class="fas fa-calendar-check"></i>
                <span>Reservations</span>
            </a>
            <a href="@Url.Action("Librarian", "AdminDashboard")" class="nav-item" data-page="librarian">
                <i class="fas fa-user-tie"></i>
                <span>User Management</span>
            </a>
            <a href="@Url.Action("Rooms", "AdminDashboard")" class="nav-item" data-page="rooms">
                <i class="fas fa-door-open"></i>
                <span>Manage Rooms</span>
            </a>
            <a href="@Url.Action("Archives", "AdminDashboard")" class="nav-item" data-page="archives">
                <i class="fas fa-archive"></i>
                <span>Archives</span>
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navigation -->
        <header class="topbar">
            <div class="topbar-left">
                <button class="menu-toggle mobile-only" id="menuToggle">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <div class="content-header">
                <h1>Dashboard</h1>
                <p>Welcome back, Administrator! Here's an overview of your system.</p>
            </div>

            <div class="topbar-actions">
                <div class="user-profile" id="userProfile">
                    <img src="https://ui-avatars.com/api/?name=Admin+User&background=c62828&color=fff" alt="Admin">
                    <div class="user-info">
                        <span class="user-name">ADMINISTRATOR</span>
                        <span class="user-role">System Administrator</span>
                    </div>
                    <i class="fas fa-chevron-down dropdown-arrow"></i>

                    <!-- User Dropdown Menu -->
                    <div class="user-dropdown" id="userDropdown">
                        <div class="dropdown-divider"></div>
                        @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm" }))
                        {
                            @Html.AntiForgeryToken()
                            <a href="#" class="dropdown-item logout" onclick="document.getElementById('logoutForm').submit()">
                                <i class="fas fa-sign-out-alt"></i>
                                <span>Logout</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </header>

        <!-- Dashboard Content -->
        <main class="content">
            <!-- Stats Cards -->
            <div class="stats-grid">
                <div class="stat-card blue">
                    <div class="stat-icon">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <div class="stat-details">
                        <h3 id="totalReservations">@ViewBag.TotalReservations</h3>
                        <p>Total Reservations</p>
                    </div>
                    <div class="stat-change positive">
                        <i class="fas fa-arrow-up"></i> <span id="reservationsChange">@ViewBag.ReservationsChange%</span>
                    </div>
                </div>

                <div class="stat-card yellow">
                    <div class="stat-icon">
                        <i class="fas fa-door-open"></i>
                    </div>
                    <div class="stat-details">
                        <h3 id="availableRooms">@ViewBag.AvailableRooms</h3>
                        <p>Available Rooms</p>
                    </div>
                    <div class="stat-change negative">
                        <i class="fas fa-arrow-down"></i> <span id="roomsChange">@ViewBag.RoomsChange%</span>
                    </div>
                </div>

                <div class="stat-card dark">
                    <div class="stat-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="stat-details">
                        <h3 id="userCount">@ViewBag.TotalUsers</h3>
                        <p>Total Users</p>
                    </div>
                    <div class="stat-change positive">
                        <i class="fas fa-arrow-up"></i> <span id="userChange">@ViewBag.UserChange%</span>
                    </div>
                </div>
            </div>

            <!-- Charts Section -->
            <div class="charts-grid">
                <div class="card chart-card">
                    <div class="card-header">
                        <h2>Reservation Trends</h2>
                        <div class="chart-controls">
                            <select id="chartPeriod" class="chart-select">
                                <option value="week">Last 7 Days</option>
                                <option value="month">Last 30 Days</option>
                                <option value="year">Last Year</option>
                            </select>
                        </div>
                    </div>
                    <div class="card-body">
                        <canvas id="reservationsChart"></canvas>
                    </div>
                </div>

                <div class="card chart-card">
                    <div class="card-header">
                        <h2>Room Utilization</h2>
                    </div>
                    <div class="card-body">
                        <canvas id="roomUtilizationChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Content Grid -->
            <div class="dashboard-grid">
                <!-- Recent Reservations -->
                <div class="card recent-activity">
                    <div class="card-header">
                        <h2>Recent Reservations</h2>
                        <button class="btn-link" onclick="viewAllReservations()">View All</button>
                    </div>
                    <div class="card-body" id="recentReservationsContainer">
                        @if (ViewBag.RecentReservations != null && ((List<LiBook.Models.ViewModel.RecentReservationViewModel>)ViewBag.RecentReservations).Count > 0)
                        {
                            foreach (var reservation in (List<LiBook.Models.ViewModel.RecentReservationViewModel>)ViewBag.RecentReservations)
                            {
                                <div class="activity-item">
                                    <div class="activity-icon @reservation.ActivityIconColor">
                                        <i class="@reservation.ActivityIcon"></i>
                                    </div>
                                    <div class="activity-details">
                                        <p><strong>@reservation.Status Booking</strong></p>
                                        <span>@reservation.RoomName - @reservation.ReserveeName</span>
                                        <small>@reservation.FormattedDate, @reservation.FormattedTime</small>
                                    </div>
                                    <span class="activity-time">@reservation.TimeAgo</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="fas fa-calendar-times empty-icon"></i>
                                <p>No Recent Reservations for now.</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Room Availability -->
                <div class="card popular-books">
                    <div class="card-header">
                        <h2>Room Availability Today</h2>
                        <button class="btn-link" onclick="viewAllRooms()">View All</button>
                    </div>
                    <div class="card-body" id="roomAvailabilityContainer">
                        @if (ViewBag.RoomAvailabilityToday != null && ((List<LiBook.Models.ViewModel.RoomAvailabilityViewModel>)ViewBag.RoomAvailabilityToday).Count > 0)
                        {
                            foreach (var room in (List<LiBook.Models.ViewModel.RoomAvailabilityViewModel>)ViewBag.RoomAvailabilityToday)
                            {
                                <div class="book-item">
                                    <div class="book-rank @room.StatusClass">@room.RankLetter</div>
                                    <div class="book-info">
                                        <h4>@room.RoomName</h4>
                                        <p>Capacity: @room.Capacity people</p>
                                    </div>
                                    <span class="book-borrows @room.StatusClass">@room.DisplayStatus</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="fas fa-door-closed empty-icon"></i>
                                <p>No available rooms for now.</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </main>
    </div>
    <!-- Add these scripts after Chart.js but before your Admindashboard.js -->
    <script>
    // Pass server-side data to JavaScript
    window.reservationTrendsWeek = @Html.Raw(ViewBag.ReservationTrendsWeekJson ?? "[]");
    window.reservationTrendsMonth = @Html.Raw(ViewBag.ReservationTrendsMonthJson ?? "[]");
    window.reservationTrendsYear = @Html.Raw(ViewBag.ReservationTrendsYearJson ?? "[]");
    window.roomUtilization = @Html.Raw(ViewBag.RoomUtilizationJson ?? "[]");
    window.recentReservations = @Html.Raw(ViewBag.RecentReservationsJson ?? "[]");
    window.roomAvailabilityToday = @Html.Raw(ViewBag.RoomAvailabilityTodayJson ?? "[]");
    </script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/Scripts/Admindashboard.js"></script>
</body>
</html>