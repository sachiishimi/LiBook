@{
    ViewData["Title"] = "Admin Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - LiBook</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@100..900&family=League+Spartan:wght@100..900&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Young+Serif&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="~/Content/admindashboard.css" rel="stylesheet" />
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <h2 class="logo">Li<span>Book</span></h2>
            <button class="close-btn" id="closeSidebar">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <nav class="sidebar-nav">
            <a href="@Url.Action("Index", "AdminDashboard")" class="nav-item active" data-page="dashboard">
                <i class="fas fa-home"></i>
                <span>DASHBOARD</span>
            </a>
            <a href="@Url.Action("Reservations", "AdminDashboard")" class="nav-item" data-page="reservations">
                <i class="fas fa-calendar-check"></i>
                <span>RESERVATIONS</span>
            </a>
            <a href="@Url.Action("Librarian", "AdminDashboard")" class="nav-item" data-page="librarian">
                <i class="fas fa-user-tie"></i>
                <span>LIBRARIAN MANAGEMENT</span>
            </a>
            <a href="@Url.Action("Rooms", "AdminDashboard")" class="nav-item" data-page="rooms">
                <i class="fas fa-door-open"></i>
                <span>ROOM MANAGEMENT</span>
            </a>
            <a href="@Url.Action("Archives", "AdminDashboard")" class="nav-item" data-page="archives">
                <i class="fas fa-archive"></i>
                <span>ARCHIVES</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm" }))
            {
                @Html.AntiForgeryToken()
                <a href="#" class="nav-item logout" onclick="document.getElementById('logoutForm').submit()">
                    <i class="fas fa-sign-out-alt"></i>
                    <span>LOGOUT</span>
                </a>
            }
        </div>
    </aside>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navigation -->
        <header class="topbar">
            <button class="menu-toggle" id="menuToggle">
                <i class="fas fa-bars"></i>
            </button>

            <div class="search-bar">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Search...">
            </div>

            <div class="topbar-actions">
                <button class="icon-btn notification-btn">
                    <i class="fas fa-bell"></i>
                    <span class="badge">3</span>
                </button>
                <div class="user-profile">
                    <img src="https://ui-avatars.com/api/?name=Admin+User&background=c62828&color=fff" alt="Admin">
                    <div class="user-info">
                        <span class="user-name">ADMINISTRATOR</span>
                        <span class="user-role">System Administrator</span>
                    </div>
                </div>
            </div>
        </header>

        <!-- Dashboard Content -->
        <main class="content">
            <div class="content-header">
                <h1>Dashboard</h1>
                <p>Welcome back, Administrator! Here's an overview of your library system.</p>
            </div>

            <!-- Stats Cards -->
            <div class="stats-grid">
                <div class="stat-card blue">
                    <div class="stat-icon">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <div class="stat-details">
                        <h3 id="totalReservations">0</h3>
                        <p>Total Reservations</p>
                    </div>
                    <div class="stat-change positive">
                        <i class="fas fa-arrow-up"></i> <span id="reservationsChange">0%</span>
                    </div>
                </div>

                <div class="stat-card red">
                    <div class="stat-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="stat-details">
                        <h3 id="activeLibrarians">0</h3>
                        <p>Active Librarians</p>
                    </div>
                    <div class="stat-change positive">
                        <i class="fas fa-arrow-up"></i> <span id="librariansChange">0%</span>
                    </div>
                </div>

                <div class="stat-card yellow">
                    <div class="stat-icon">
                        <i class="fas fa-door-open"></i>
                    </div>
                    <div class="stat-details">
                        <h3 id="availableRooms">0</h3>
                        <p>Available Rooms</p>
                    </div>
                    <div class="stat-change negative">
                        <i class="fas fa-arrow-down"></i> <span id="roomsChange">0%</span>
                    </div>
                </div>

                <div class="stat-card dark">
                    <div class="stat-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="stat-details">
                        <h3 id="pendingApprovals">0</h3>
                        <p>Pending Approvals</p>
                    </div>
                    <div class="stat-change positive">
                        <i class="fas fa-arrow-up"></i> <span id="approvalsChange">0%</span>
                    </div>
                </div>
            </div>

            <!-- Content Grid -->
            <div class="dashboard-grid">
                <!-- Recent Reservations -->
                <div class="card recent-activity">
                    <div class="card-header">
                        <h2>Recent Reservations</h2>
                        <button class="btn-link" onclick="viewAllReservations()">View All</button>
                    </div>
                    <div class="card-body">
                        <div class="activity-item">
                            <div class="activity-icon blue">
                                <i class="fas fa-calendar-plus"></i>
                            </div>
                            <div class="activity-details">
                                <p><strong>New reservation request</strong></p>
                                <span>Collaboration Room A - Today, 2:00 PM</span>
                            </div>
                            <span class="activity-time">10 min ago</span>
                        </div>
                        <div class="activity-item">
                            <div class="activity-icon red">
                                <i class="fas fa-user-check"></i>
                            </div>
                            <div class="activity-details">
                                <p><strong>Reservation approved</strong></p>
                                <span>Study Room B - John Smith</span>
                            </div>
                            <span class="activity-time">1 hour ago</span>
                        </div>
                        <div class="activity-item">
                            <div class="activity-icon yellow">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div class="activity-details">
                                <p><strong>Upcoming reservation</strong></p>
                                <span>Meeting Room C - Starting in 30 min</span>
                            </div>
                            <span class="activity-time">2 hours ago</span>
                        </div>
                        <div class="activity-item">
                            <div class="activity-icon dark">
                                <i class="fas fa-times-circle"></i>
                            </div>
                            <div class="activity-details">
                                <p><strong>Reservation cancelled</strong></p>
                                <span>Study Room D - Conflict in schedule</span>
                            </div>
                            <span class="activity-time">3 hours ago</span>
                        </div>
                    </div>
                </div>

                <!-- Room Availability -->
                <div class="card popular-books">
                    <div class="card-header">
                        <h2>Room Availability Today</h2>
                        <button class="btn-link" onclick="viewAllRooms()">View All</button>
                    </div>
                    <div class="card-body">
                        <div class="book-item">
                            <div class="book-rank available">A</div>
                            <div class="book-info">
                                <h4>Collaboration Room A</h4>
                                <p>Capacity: 8 people</p>
                            </div>
                            <span class="book-borrows available">Available</span>
                        </div>
                        <div class="book-item">
                            <div class="book-rank occupied">B</div>
                            <div class="book-info">
                                <h4>Study Room B</h4>
                                <p>Capacity: 4 people</p>
                            </div>
                            <span class="book-borrows occupied">Occupied</span>
                        </div>
                        <div class="book-item">
                            <div class="book-rank available">C</div>
                            <div class="book-info">
                                <h4>Meeting Room C</h4>
                                <p>Capacity: 12 people</p>
                            </div>
                            <span class="book-borrows available">Available</span>
                        </div>
                        <div class="book-item">
                            <div class="book-rank maintenance">D</div>
                            <div class="book-info">
                                <h4>Study Room D</h4>
                                <p>Capacity: 6 people</p>
                            </div>
                            <span class="book-borrows maintenance">Maintenance</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="quick-actions">
                <h2>Quick Actions</h2>
                <div class="actions-grid">
                    <button class="action-btn blue" onclick="manageReservations()">
                        <i class="fas fa-calendar-alt"></i>
                        <span>Manage Reservations</span>
                    </button>
                    <button class="action-btn red" onclick="manageLibrarians()">
                        <i class="fas fa-user-tie"></i>
                        <span>Manage Librarians</span>
                    </button>
                    <button class="action-btn yellow" onclick="manageRooms()">
                        <i class="fas fa-door-open"></i>
                        <span>Manage Rooms</span>
                    </button>
                    <button class="action-btn dark" onclick="viewReports()">
                        <i class="fas fa-chart-bar"></i>
                        <span>View Reports</span>
                    </button>
                </div>
            </div>
        </main>
    </div>

    <script src="~/Scripts/Admindashboard.js"></script>
</body>
</html>