                                    Please enter a valid email address
                                </span>
                            </div>

                            <div class="form-group full-width">
                                <label>Username <span class="required">*</span></label>
                                <input type="text" class="form-control" id="editUsername" placeholder="Enter username" required>
                                <span class="error-message" id="editUsernameError">
                                    <i class="fas fa-exclamation-circle"></i>
                                    Username is required
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Security Section -->
                    <div class="form-section">
                        <div class="form-section-header">
                            <i class="fas fa-lock"></i>
                            <h3>Change Password</h3>
                            <span class="section-badge optional-badge">Optional</span>
                        </div>
                        <p class="section-description">Leave blank to keep the current password</p>

                        <div class="form-grid">
                            <div class="form-group">
                                <label>New Password <span class="optional">(Optional)</span></label>
                                <div class="password-container">
                                    <input type="password" class="form-control" id="editNewPassword" placeholder="Enter new password" autocomplete="new-password">
                                    <button type="button" class="password-toggle" data-target="editNewPassword">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span class="error-message" id="editPasswordError">
                                    <i class="fas fa-exclamation-circle"></i>
                                    Password does not meet requirements
                                </span>
                            </div>

                            <div class="form-group">
                                <label>Confirm New Password</label>
                                <div class="password-container">
                                    <input type="password" class="form-control" id="editConfirmPassword" placeholder="Re-enter new password" autocomplete="new-password">
                                    <button type="button" class="password-toggle" data-target="editConfirmPassword">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span class="error-message" id="editConfirmPasswordError">
                                    <i class="fas fa-exclamation-circle"></i>
                                    Passwords do not match
                                </span>
                            </div>
                        </div>

                        <div class="password-requirements" id="editPasswordRequirements" style="display: none;">
                            <p class="requirements-title"><i class="fas fa-info-circle"></i> Password Requirements:</p>
                            <div class="requirements-list">
                                <div class="requirement" id="editReqLength">
                                    <i class="fas fa-circle"></i>
                                    <span>At least 8 characters long</span>
                                </div>
                                <div class="requirement" id="editReqNumber">
                                    <i class="fas fa-circle"></i>
                                    <span>Contains at least one number</span>
                                </div>
                                <div class="requirement" id="editReqSymbol">
                                    <i class="fas fa-circle"></i>
                                    <span>Contains a special character (#, *, &)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="cancelEditModalBtn">
                    <i class="fas fa-times"></i>
                    <span>Cancel</span>
                </button>
                <button type="button" class="btn btn-primary" id="submitEditBtn">
                    <i class="fas fa-check"></i>
                    <span>Save Changes</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Confirmation Modal -->
    <div class="modal-overlay" id="confirmationModal">
        <div class="modal-container modal-confirm">
            <div class="modal-header">
                <div class="modal-header-content">
                    <div class="modal-icon-wrapper confirm">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <div class="modal-title-wrapper">
                        <h2>Confirm Changes</h2>
                        <p class="modal-subtitle">Administrator verification required</p>
                    </div>
                </div>
                <button class="close-modal" id="closeConfirmModalBtn" type="button">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="confirmation-alert">
                    <div class="alert-icon">
                        <i class="fas fa-info-circle"></i>
                    </div>
                    <div class="alert-content">
                        <h4>Security Verification</h4>
                        <p>To confirm these changes, please enter your administrator password. This action will update the user's information in the system.</p>
                    </div>
                </div>

                <form id="confirmationForm">
                    <div class="form-section">
                        <div class="form-group">
                            <label>Administrator Password <span class="required">*</span></label>
                            <div class="password-container">
                                <input type="password" class="form-control" id="adminPassword" placeholder="Enter your password" required autocomplete="current-password">
                                <button type="button" class="password-toggle" data-target="adminPassword">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <span class="error-message" id="adminPasswordError">
                                <i class="fas fa-exclamation-circle"></i>
                                Administrator password is required
                            </span>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="backToEditBtn">
                    <i class="fas fa-arrow-left"></i>
                    <span>Back</span>
                </button>
                <button type="button" class="btn btn-primary btn-confirm" id="confirmSubmitBtn">
                    <i class="fas fa-check-circle"></i>
                    <span>Confirm Changes</span>
                </button>
            </div>
        </div>
    </div>

    <script src="~/Scripts/librarian.js"></script>
    </script>
</body>
</html>
