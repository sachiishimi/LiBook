    <!-- Add User Modal -->
    <div class="modal-overlay" id="addUserModal">
        <div class="modal-container modal-large">
            <div class="modal-header">
                <div class="modal-header-content">
                    <div class="modal-icon-wrapper add">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <div class="modal-title-wrapper">
                        <h2>Add New User</h2>
                        <p class="modal-subtitle">Fill in the details to create a new user account</p>
                    </div>
                </div>
                <button class="close-modal" id="closeAddModalBtn" type="button">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="modal-body">
                <form id="addUserForm">
                    <!-- Personal Information Section -->
                    <div class="form-section">
                        <div class="form-section-header">
                            <i class="fas fa-user-circle"></i>
                            <h3>Personal Information</h3>
                        </div>

                        <div class="form-grid">
                            <div class="form-group">
                                <label>First Name <span class="required">*</span></label>
                                <input type="text" class="form-control" id="firstName" placeholder="Enter first name" required>
                                <span class="error-message" id="firstNameError">
                                    <i class="fas fa-exclamation-circle"></i>
                                    First name is required
                                </span>
                            </div>

                            <div class="form-group">
                                <label>Last Name <span class="required">*</span></label>
                                <input type="text" class="form-control" id="lastName" placeholder="Enter last name" required>
                                <span class="error-message" id="lastNameError">
                                    <i class="fas fa-exclamation-circle"></i>
                                    Last name is required
                                </span>
                            </div>

                            <div class="form-group">
                                <label>Middle Name <span class="optional">(Optional)</span></label>
                                <input type="text" class="form-control" id="middleName" placeholder="Enter middle name">
                            </div>

                            <div class="form-group">
                                <label>Suffix <span class="optional">(Optional)</span></label>
                                <input type="text" class="form-control" id="suffix" placeholder="Jr., Sr., III">
                            </div>
                        </div>
                    </div>

                    <!-- Account Information Section -->
                    <div class="form-section">
                        <div class="form-section-header">
                            <i class="fas fa-id-card"></i>
                            <h3>Account Information</h3>
                        </div>

                        <div class="form-grid">
                            <div class="form-group full-width">
                                <label>Email Address <span class="required">*</span></label>
                                <input type="email" class="form-control" id="email" placeholder="user@example.com" required>
                                <span class="error-message" id="emailError">
                                    <i class="fas fa-exclamation-circle"></i>
                                    Please enter a valid email address
                                </span>
                            </div>

                            <div class="form-group full-width">
                                <label>Username <span class="required">*</span></label>
                                <input type="text" class="form-control" id="username" placeholder="Enter username" required>
                                <span class="error-message" id="usernameError">
                                    <i class="fas fa-exclamation-circle"></i>
                                    Username is required
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Security Section -->
                    <div class="form-section">
                        <div class="form-section-header">
                            <i class="fas fa-lock"></i>
                            <h3>Security</h3>
                        </div>

                        <div class="form-grid">
                            <div class="form-group">
                                <label>Password <span class="required">*</span></label>
                                <div class="password-container">
                                    <input type="password" class="form-control" id="password" placeholder="Enter password" required autocomplete="new-password">
                                    <button type="button" class="password-toggle" data-target="password">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span class="error-message" id="passwordError">
                                    <i class="fas fa-exclamation-circle"></i>
                                    Password does not meet requirements
                                </span>
                            </div>

                            <div class="form-group">
                                <label>Confirm Password <span class="required">*</span></label>
                                <div class="password-container">
                                    <input type="password" class="form-control" id="confirmPassword" placeholder="Re-enter password" required autocomplete="new-password">
                                    <button type="button" class="password-toggle" data-target="confirmPassword">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span class="error-message" id="confirmPasswordError">
                                    <i class="fas fa-exclamation-circle"></i>
                                    Passwords do not match
                                </span>
                            </div>
                        </div>

                        <div class="password-requirements" id="passwordRequirements" style="display: none;">
                            <p class="requirements-title"><i class="fas fa-info-circle"></i> Password Requirements:</p>
                            <div class="requirements-list">
                                <div class="requirement" id="reqLength">
                                    <i class="fas fa-circle"></i>
                                    <span>At least 8 characters long</span>
                                </div>
                                <div class="requirement" id="reqNumber">
                                    <i class="fas fa-circle"></i>
                                    <span>Contains at least one number</span>
                                </div>
                                <div class="requirement" id="reqSymbol">
                                    <i class="fas fa-circle"></i>
                                    <span>Contains a special character (#, *, &)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="cancelAddModalBtn">
                    <i class="fas fa-times"></i>
                    <span>Cancel</span>
                </button>
                <button type="button" class="btn btn-primary" id="submitAddBtn">
                    <i class="fas fa-check"></i>
                    <span>Create User</span>
                </button>
            </div>
        </div>
    </div>

