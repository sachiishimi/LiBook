@{
    ViewBag.Title = "User Management";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - LiBook</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@100..900&family=League+Spartan:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="~/Content/librarian.css" rel="stylesheet" />
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <svg class="logo-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15 15">
                    <path fill="currentColor" d="M1.082 9.939C.987 9.867 1 9.748 1 9.748L1.526 3.5s.008-.069.039-.104c.019-.022.043-.054.09-.073C2.182 3.107 5.053 1.552 6.5 3c.24.278.5.688.5 1v5.288s.006.112-.095.18a.25.25 0 0 1-.242.003c-2.226-1.114-4.711.154-5.338.487a.22.22 0 0 1-.243-.02m12.593.019c-.627-.333-3.112-1.6-5.338-.487a.25.25 0 0 1-.242-.003C7.994 9.4 8 9.288 8 9.288V4c0-.312.26-.722.5-1c1.446-1.448 4.3.107 4.827.323c.046.019.07.051.09.073c.03.035.039.104.039.104l.543 6.248s.014.119-.08.19a.22.22 0 0 1-.244.02m-4.81 2.728a.24.24 0 0 0 .118-.077a.2.2 0 0 0 .042-.109c.05-.938 1.624-1.812 4.648-.03c.077.044.166.04.242-.015c.086-.063.085-.17.085-.17v-.553s0-.077-.027-.119a.23.23 0 0 0-.093-.085c-2.025-1.315-4.586-1.898-5.885-.16a.2.2 0 0 1-.073.09c-.057.045-.126.042-.126.042h-.585s-.07.003-.126-.041a.2.2 0 0 1-.073-.09c-1.3-1.739-3.86-1.184-5.885.131a.23.23 0 0 0-.093.086c-.027.042-.027.118-.027.118v.554s-.001.107.085.17a.22.22 0 0 0 .243.015c3.023-1.782 4.598-.88 4.647.057a.2.2 0 0 0 .043.109a.24.24 0 0 0 .118.077c.721.18 1.768.25 2.722 0" />
                </svg>
                <h2 class="logo">Li<span>Book</span></h2>
            </div>
            <button class="close-btn" id="closeSidebar">
                <i class="fas fa-times"></i>
            </button>
            <button class="menu-toggle-sidebar desktop-only" id="sidebarToggleDesktop">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <nav class="sidebar-nav">
            <a href="@Url.Action("Index", "AdminDashboard")" class="nav-item" data-page="dashboard">
                <i class="fas fa-home"></i>
                <span>Dashboard</span>
            </a>
            <a href="@Url.Action("Reservations", "AdminDashboard")" class="nav-item" data-page="reservations">
                <i class="fas fa-calendar-check"></i>
                <span>Reservations</span>
            </a>
            <a href="@Url.Action("Librarian", "AdminDashboard")" class="nav-item active" data-page="librarian">
                <i class="fas fa-user-tie"></i>
                <span>User Management</span>
            </a>
            <a href="@Url.Action("Rooms", "AdminDashboard")" class="nav-item" data-page="rooms">
                <i class="fas fa-door-open"></i>
                <span>Manage Rooms</span>
            </a>
            <a href="@Url.Action("Archives", "AdminDashboard")" class="nav-item" data-page="archives">
                <i class="fas fa-archive"></i>
                <span>Archives</span>
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navigation -->
        <header class="topbar">
            <div class="topbar-left">
                <button class="menu-toggle mobile-only" id="menuToggle">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <div class="search-bar">
                <i class="fas fa-search"></i>
                <input type="text" id="userSearch" placeholder="Search users...">
            </div>

            <div class="topbar-actions">
                <button class="icon-btn notification-btn">
                    <i class="fas fa-bell"></i>
                    <span class="badge">3</span>
                </button>
                <div class="user-profile" id="userProfile">
                    <img src="https://ui-avatars.com/api/?name=Admin+User&background=c62828&color=fff" alt="Admin">
                    <div class="user-info">
                        <span class="user-name">ADMINISTRATOR</span>
                        <span class="user-role">System Administrator</span>
                    </div>
                    <i class="fas fa-chevron-down dropdown-arrow"></i>

                    <!-- User Dropdown Menu -->
                    <div class="user-dropdown" id="userDropdown">
                        <a href="#" class="dropdown-item">
                            <i class="fas fa-user-cog"></i>
                            <span>Settings</span>
                        </a>
                        <a href="#" class="dropdown-item">
                            <i class="fas fa-question-circle"></i>
                            <span>Help & Support</span>
                        </a>
                        <div class="dropdown-divider"></div>
                        @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm" }))
                        {
                            @Html.AntiForgeryToken()
                            <a href="#" class="dropdown-item logout" onclick="document.getElementById('logoutForm').submit()">
                                <i class="fas fa-sign-out-alt"></i>
                                <span>Logout</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </header>

        <!-- User Management Content -->
        <main class="content">
            <div class="content-header">
                <h1>User Management</h1>
                <p>Manage librarians and administrators in the system.</p>
            </div>

            <!-- Tabs and Action Bar -->
            <div class="user-management-header">
                <div class="tabs-container">
                    <button class="tab-btn active" data-tab="librarians">
                        <i class="fas fa-user-tie"></i>
                        Librarians
                    </button>
                    <button class="tab-btn" data-tab="admins">
                        <i class="fas fa-users-cog"></i>
                        Admins
                    </button>
                </div>
                <button class="btn btn-primary" id="addUserBtn">
                    <i class="fas fa-plus"></i>
                    <span>Add Librarian</span>
                </button>
            </div>

            <!-- Tables Container -->
            <div class="tables-container">
                <!-- Librarians Table -->
                <div class="table-section active" id="librarians-section">
                    <div class="card">
                        <div class="card-header">
                            <h2>Librarians</h2>
                            <span class="user-count">5 librarians</span>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="users-table">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Username</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>
                                                <div class="user-info-cell">
                                                    <div class="user-avatar">
                                                        <i class="fas fa-user"></i>
                                                    </div>
                                                    <div class="user-details">
                                                        <span class="user-name">Sarah Johnson</span>
                                                        <span class="user-email">sarah.j@library.edu</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>sarah.johnson</td>
                                            <td>
                                                <span class="status-badge active">Active</span>
                                            </td>
                                            <td>
                                                <div class="action-buttons">
                                                    <button class="icon-btn small" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="icon-btn small danger" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <div class="user-info-cell">
                                                    <div class="user-avatar">
                                                        <i class="fas fa-user"></i>
                                                    </div>
                                                    <div class="user-details">
                                                        <span class="user-name">Michael Chen</span>
                                                        <span class="user-email">michael.c@library.edu</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>michael.chen</td>
                                            <td>
                                                <span class="status-badge active">Active</span>
                                            </td>
                                            <td>
                                                <div class="action-buttons">
                                                    <button class="icon-btn small" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="icon-btn small danger" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <div class="user-info-cell">
                                                    <div class="user-avatar">
                                                        <i class="fas fa-user"></i>
                                                    </div>
                                                    <div class="user-details">
                                                        <span class="user-name">Emily Rodriguez</span>
                                                        <span class="user-email">emily.r@library.edu</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>emily.rodriguez</td>
                                            <td>
                                                <span class="status-badge inactive">Inactive</span>
                                            </td>
                                            <td>
                                                <div class="action-buttons">
                                                    <button class="icon-btn small" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="icon-btn small danger" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <div class="user-info-cell">
                                                    <div class="user-avatar">
                                                        <i class="fas fa-user"></i>
                                                    </div>
                                                    <div class="user-details">
                                                        <span class="user-name">David Kim</span>
                                                        <span class="user-email">david.k@library.edu</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>david.kim</td>
                                            <td>
                                                <span class="status-badge active">Active</span>
                                            </td>
                                            <td>
                                                <div class="action-buttons">
                                                    <button class="icon-btn small" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="icon-btn small danger" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <div class="user-info-cell">
                                                    <div class="user-avatar">
                                                        <i class="fas fa-user"></i>
                                                    </div>
                                                    <div class="user-details">
                                                        <span class="user-name">Jessica Williams</span>
                                                        <span class="user-email">jessica.w@library.edu</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>jessica.williams</td>
                                            <td>
                                                <span class="status-badge active">Active</span>
                                            </td>
                                            <td>
                                                <div class="action-buttons">
                                                    <button class="icon-btn small" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="icon-btn small danger" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Admins Table -->
                <div class="table-section" id="admins-section">
                    <div class="card">
                        <div class="card-header">
                            <h2>Administrators</h2>
                            <span class="user-count">3 administrators</span>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="users-table">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Username</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>
                                                <div class="user-info-cell">
                                                    <div class="user-avatar admin">
                                                        <i class="fas fa-user-shield"></i>
                                                    </div>
                                                    <div class="user-details">
                                                        <span class="user-name">Robert Wilson</span>
                                                        <span class="user-email">robert.w@library.edu</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>robert.wilson</td>
                                            <td>
                                                <span class="status-badge active">Active</span>
                                            </td>
                                            <td>
                                                <div class="action-buttons">
                                                    <button class="icon-btn small" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="icon-btn small danger" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <div class="user-info-cell">
                                                    <div class="user-avatar admin">
                                                        <i class="fas fa-user-shield"></i>
                                                    </div>
                                                    <div class="user-details">
                                                        <span class="user-name">Lisa Thompson</span>
                                                        <span class="user-email">lisa.t@library.edu</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>lisa.thompson</td>
                                            <td>
                                                <span class="status-badge active">Active</span>
                                            </td>
                                            <td>
                                                <div class="action-buttons">
                                                    <button class="icon-btn small" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="icon-btn small danger" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>
                                                <div class="user-info-cell">
                                                    <div class="user-avatar admin">
                                                        <i class="fas fa-user-shield"></i>
                                                    </div>
                                                    <div class="user-details">
                                                        <span class="user-name">James Martinez</span>
                                                        <span class="user-email">james.m@library.edu</span>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>james.martinez</td>
                                            <td>
                                                <span class="status-badge inactive">Inactive</span>
                                            </td>
                                            <td>
                                                <div class="action-buttons">
                                                    <button class="icon-btn small" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="icon-btn small danger" title="Delete">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="~/Scripts/librarian.js"></script>
</body>
</html>