@model IEnumerable<LiBook.Models.Room>

@{
    ViewBag.Title = "Room Management";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - LiBook</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@100..900&family=League+Spartan:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="@Url.Content("~/Content/rooms.css")" rel="stylesheet" />

</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <svg class="logo-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15 15">
                    <path fill="currentColor" d="M1.082 9.939C.987 9.867 1 9.748 1 9.748L1.526 3.5s.008-.069.039-.104c.019-.022.043-.054.09-.073C2.182 3.107 5.053 1.552 6.5 3c.24.278.5.688.5 1v5.288s.006.112-.095.18a.25.25 0 0 1-.242.003c-2.226-1.114-4.711.154-5.338.487a.22.22 0 0 1-.243-.02m12.593.019c-.627-.333-3.112-1.6-5.338-.487a.25.25 0 0 1-.242-.003C7.994 9.4 8 9.288 8 9.288V4c0-.312.26-.722.5-1c1.446-1.448 4.3.107 4.827.323c.046.019.07.051.09.073c.03.035.039.104.039.104l.543 6.248s.014.119-.08.19a.22.22 0 0 1-.244.02m-4.81 2.728a.24.24 0 0 0 .118-.077a.2.2 0 0 0 .042-.109c.05-.938 1.624-1.812 4.648-.03c.077.044.166.04.242-.015c.086-.063.085-.17.085-.17v-.553s0-.077-.027-.119a.23.23 0 0 0-.093-.085c-2.025-1.315-4.586-1.898-5.885-.16a.2.2 0 0 1-.073.09c-.057.045-.126.042-.126.042h-.585s-.07.003-.126-.041a.2.2 0 0 1-.073-.09c-1.3-1.739-3.86-1.184-5.885.131a.23.23 0 0 0-.093.086c-.027.042-.027.118-.027.118v.554s-.001.107.085.17a.22.22 0 0 0 .243.015c3.023-1.782 4.598-.88 4.647.057a.2.2 0 0 0 .043.109a.24.24 0 0 0 .118.077c.721.18 1.768.25 2.722 0" />
                </svg>
                <h2 class="logo">Li<span>Book</span></h2>
            </div>
            <button class="close-btn" id="closeSidebar">
                <i class="fas fa-times"></i>
            </button>
            <button class="menu-toggle-sidebar desktop-only" id="sidebarToggleDesktop">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <nav class="sidebar-nav">
            <a href="@Url.Action("Index", "AdminDashboard")" class="nav-item" data-page="dashboard">
                <i class="fas fa-home"></i>
                <span>Dashboard</span>
            </a>
            <a href="@Url.Action("Reservations", "AdminDashboard")" class="nav-item" data-page="reservations">
                <i class="fas fa-calendar-check"></i>
                <span>Reservations</span>
            </a>
            <a href="@Url.Action("Librarian", "AdminDashboard")" class="nav-item" data-page="librarian">
                <i class="fas fa-user-tie"></i>
                <span>User Management</span>
            </a>
            <a href="@Url.Action("Rooms", "AdminDashboard")" class="nav-item active" data-page="rooms">
                <i class="fas fa-door-open"></i>
                <span>Manage Rooms</span>
            </a>
            <a href="@Url.Action("Archives", "AdminDashboard")" class="nav-item" data-page="archives">
                <i class="fas fa-archive"></i>
                <span>Archives</span>
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navigation -->
        <header class="topbar">
            <div class="topbar-left">
                <button class="menu-toggle mobile-only" id="menuToggle">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <div class="search-bar">
                <i class="fas fa-search"></i>
                <input type="text" placeholder="Search...">
            </div>

            <div class="topbar-actions">
                <button class="icon-btn notification-btn">
                    <i class="fas fa-bell"></i>
                    <span class="badge">3</span>
                </button>
                <div class="user-profile" id="userProfile">
                    <img src="https://ui-avatars.com/api/?name=Admin+User&background=c62828&color=fff" alt="Admin">
                    <div class="user-info">
                        <span class="user-name">ADMINISTRATOR</span>
                        <span class="user-role">System Administrator</span>
                    </div>
                    <i class="fas fa-chevron-down dropdown-arrow"></i>

                    <!-- User Dropdown Menu -->
                    <div class="user-dropdown" id="userDropdown">
                        <a href="#" class="dropdown-item">
                            <i class="fas fa-user-cog"></i>
                            <span>Settings</span>
                        </a>
                        <a href="#" class="dropdown-item">
                            <i class="fas fa-question-circle"></i>
                            <span>Help & Support</span>
                        </a>
                        <div class="dropdown-divider"></div>
                        @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm" }))
                        {
                            @Html.AntiForgeryToken()
                            <a href="#" class="dropdown-item logout" onclick="document.getElementById('logoutForm').submit()">
                                <i class="fas fa-sign-out-alt"></i>
                                <span>Logout</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </header>

        <!-- Room Management Content -->
        <main class="content">
            <div class="content-header">
                <h1>Room Management</h1>
                <p>Manage collaboration rooms and their availability.</p>
            </div>

            <div class="header-actions">
                <div class="search-container">
                    <i class="fas fa-search"></i>
                    <input type="text" id="searchRooms" placeholder="Search rooms...">
                </div>
                <div style="display: flex; gap: 1rem;">
                    <button class="btn btn-primary" id="addRoomBtn">
                        <i class="fas fa-plus"></i>
                        Add New Room
                    </button>
                </div>
            </div>

            <div class="rooms-card">
                <div class="card-header">
                    <h2>Collaboration Rooms</h2>
                    <span class="rooms-count"><span id="roomCount">@Model.Count()</span> rooms</span>
                </div>

                <table class="rooms-table">
                    <thead>
                        <tr>
                            <th width="50"></th>
                            <th>Room Name</th>
                            <th>Room Type</th>
                            <th>Capacity</th> <!-- Changed from "Room User 2" to "Capacity" -->
                            <th>Status</th>
                            <th style="text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="roomsTableBody">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="checkbox-cell"><input type="checkbox" class="custom-checkbox"></td>
                                <td>
                                    <div class="room-info">
                                        <div class="room-icon">
                                            <i class="fas fa-door-open"></i>
                                        </div>
                                        <div class="room-details">
                                            <h3>@Html.DisplayFor(modelItem => item.RoomName)</h3>
                                            <span class="room-id" data-room-id="@item.ID">Room #@Html.DisplayFor(modelItem => item.ID)</span>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="user-type student">@Html.DisplayFor(modelItem => item.RoomType)</span></td>
                                <td><span class="capacity">@Html.DisplayFor(modelItem => item.Capacity)</span></td> <!-- This is the capacity field -->
                                <td><span class="status-badge available">@Html.DisplayFor(modelItem => item.Availability)</span></td>
                                <td>
                                    <div class="action-buttons">
                                        <button class="icon-btn edit" title="Edit Room">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="icon-btn archive" title="Archive Room">
                                            <i class="fas fa-archive"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </main>
    </div>


    <!-- Add/Edit Room Modal - Redesigned -->
    <!-- Add Room Modal -->
    <div class="modal-overlay" id="addRoomModal">
        <div class="modal-container modal-medium">
            <div class="modal-header">
                <div class="modal-header-content">
                    <div class="modal-icon-wrapper room">
                        <i class="fas fa-door-open"></i>
                    </div>
                    <div class="modal-title-wrapper">
                        <h2>Add New Room</h2>
                        <p class="modal-subtitle">Configure collaboration room settings</p>
                    </div>
                </div>
                <button class="close-modal" id="closeAddModal" type="button">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="modal-body">
                @using (Html.BeginForm("CreateRoom", "AdminDashboard", FormMethod.Post, new { id = "addRoomForm" }))
                {
                    @Html.AntiForgeryToken()
                        <!-- Room Information Section -->
                        <div class="form-section">
                            <div class="form-section-header">
                                <i class="fas fa-info-circle"></i>
                                <h3>Room Information</h3>
                            </div>

                            <div class="form-grid">
                                <div class="form-group full-width">
                                    <label for="addRoomName">Room Name <span class="required">*</span></label>
                                    <input type="text" name="RoomName" class="form-control" id="addRoomName" placeholder="e.g., Student Collab Room 1" required>
                                    <span class="field-hint">
                                        <i class="fas fa-lightbulb"></i>
                                        Choose a descriptive name for easy identification
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- User Configuration Section -->
                        <div class="form-section">
                            <div class="form-section-header">
                                <i class="fas fa-users"></i>
                                <h3>User Configuration</h3>
                            </div>
                            <p class="section-description">Define who can use this collaboration room</p>

                            <div class="form-grid">
                                <div class="form-group">
                                    <label for="addRoomUser1">Primary User Type <span class="required">*</span></label>
                                    <select class="form-control" name="Roomtype" id="addRoomUser1" required>
                                        <option value="">Select user type</option>
                                        <option value="Academic">Academic</option>
                                        <option value="Faculty">Faculty</option>
                                        <option value="Public">Public</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="addCapacity">Capacity <span class="required">*</span></label>
                                    <input type="number" name="Capacity" class="form-control" id="addCapacity" placeholder="e.g., 4" min="1" max="50" required>
                                </div>
                            </div>
                        </div>

                        <!-- Room Status Section -->
                        <div class="form-section">
                            <div class="form-section-header">
                                <i class="fas fa-toggle-on"></i>
                                <h3>Room Status</h3>
                            </div>

                            <div class="form-grid">
                                <div class="form-group full-width">
                                    <label for="addRoomStatus">Availability Status <span class="required">*</span></label>
                                    <select class="form-control" name="Availability" id="addRoomStatus" required>
                                        <option value="">Select status</option>
                                        <option value="Available">Available - Ready for use</option>
                                        <option value="Unavailable">Unavailable - Currently in use</option>
                                        <option value="Under Maintenance">Under Maintenance - Not accessible</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                }
                </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="cancelAddBtn">
                    <i class="fas fa-times"></i>
                    <span>Cancel</span>
                </button>
                <button type="submit" value="Create" form="addRoomForm" class="btn btn-success">
                    <i class="fas fa-plus"></i>
                    <span>Add Room</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Edit Room Modal -->
    <div class="modal-overlay" id="editRoomModal">
        <div class="modal-container modal-medium">
            <div class="modal-header">
                <div class="modal-header-content">
                    <div class="modal-icon-wrapper room">
                        <i class="fas fa-door-open"></i>
                    </div>
                    <div class="modal-title-wrapper">
                        <h2>Edit Room</h2>
                        <p class="modal-subtitle">Update collaboration room settings</p>
                    </div>
                </div>
                <button class="close-modal" id="closeEditModal" type="button">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="modal-body">
                @using (Html.BeginForm("EditRoom", "AdminDashboard", FormMethod.Post, new { id = "editRoomForm" }))
                {
                    @Html.AntiForgeryToken()
                    <!-- Add hidden field for ID -->
                    <input type="hidden" name="ID" id="editRoomId" />

                    <!-- Room Information Section -->
                    <div class="form-section">
                        <div class="form-section-header">
                            <i class="fas fa-info-circle"></i>
                            <h3>Room Information</h3>
                        </div>

                        <div class="form-grid">
                            <div class="form-group full-width">
                                <label for="editRoomName">Room Name <span class="required">*</span></label>
                                <input type="text" name="RoomName" class="form-control" id="editRoomName" placeholder="e.g., Student Collab Room 1" required>
                                <span class="field-hint">
                                    <i class="fas fa-lightbulb"></i>
                                    Choose a descriptive name for easy identification
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- User Configuration Section -->
                    <div class="form-section">
                        <div class="form-section-header">
                            <i class="fas fa-users"></i>
                            <h3>User Configuration</h3>
                        </div>
                        <p class="section-description">Define who can use this collaboration room</p>

                        <div class="form-grid">
                            <div class="form-group">
                                <label for="editRoomUser1">Primary User Type <span class="required">*</span></label>
                                <select class="form-control" name="RoomType" id="editRoomUser1" required>
                                    <option value="">Select user type</option>
                                    <option value="Academic">Academic</option>
                                    <option value="Faculty">Faculty</option>
                                    <option value="Public">Public</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="editCapacity">Capacity <span class="required">*</span></label>
                                <input type="number" name="Capacity" class="form-control" id="editCapacity" placeholder="e.g., 4" min="1" max="50" required>
                            </div>
                        </div>
                    </div>

                    <!-- Room Status Section -->
                    <div class="form-section">
                        <div class="form-section-header">
                            <i class="fas fa-toggle-on"></i>
                            <h3>Room Status</h3>
                        </div>

                        <div class="form-grid">
                            <div class="form-group full-width">
                                <label for="editRoomStatus">Availability Status <span class="required">*</span></label>
                                <select class="form-control" name="Availability" id="editRoomStatus" required>
                                    <option value="">Select status</option>
                                    <option value="Available">Available - Ready for use</option>
                                    <option value="Unavailable">Unavailable - Currently in use</option>
                                    <option value="Under Maintenance">Under Maintenance - Not accessible</option>
                                </select>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="cancelEditBtn">
                    <i class="fas fa-times"></i>
                    <span>Cancel</span>
                </button>
                <button type="submit" value="Save" form="editRoomForm" class="btn btn-success">
                    <i class="fas fa-check"></i>
                    <span>Update Room</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Archive Confirmation Modal -->
    <div class="modal-overlay" id="archiveModal">
        <div class="modal-container modal-confirm">
            <div class="modal-header">
                <div class="modal-header-content">
                    <div class="modal-icon-wrapper archive">
                        <i class="fas fa-archive"></i>
                    </div>
                    <div class="modal-title-wrapper">
                        <h2>Archive Rooms</h2>
                        <p class="modal-subtitle">Confirm rooms to be archived</p>
                    </div>
                </div>
                <button class="close-modal" id="closeArchiveModal" type="button">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="modal-body">
                <div class="archive-alert">
                    <div class="alert-icon">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="alert-content">
                        <h4>Archive Selected Rooms</h4>
                        <p>The following rooms will be moved to archives. This action can be reversed from the archives page.</p>
                    </div>
                </div>

                <div class="archive-preview">
                    <div class="preview-header">
                        <i class="fas fa-list"></i>
                        <span>Selected Rooms (<span id="archiveCount">0</span>)</span>
                    </div>
                    <div class="preview-list" id="archivePreviewList">
                        <!-- Room items will be inserted here dynamically -->
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="cancelArchiveBtn">
                    <i class="fas fa-times"></i>
                    <span>Cancel</span>
                </button>
                <button type="button" class="btn btn-danger" id="confirmArchiveBtn">
                    <i class="fas fa-check"></i>
                    <span>Archive Rooms</span>
                </button>
            </div>
        </div>
    </div>

    <script src="~/Scripts/rooms.js"></script>
</body>
</html>
