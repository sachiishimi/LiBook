﻿@{
    ViewBag.Title = "Archives";
    ViewData["Title"] = "Archives - LiBook";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@100..900&family=League+Spartan:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="~/Content/archives.css" rel="stylesheet" />
    <style>
        .status {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            display: inline-block;
        }

        .status.inactive {
            background-color: #ffebee;
            color: #c62828;
        }

        .status.archived {
            background-color: #fff3e0;
            color: #ef6c00;
        }

        .status.cancelled {
            background-color: #e8eaf6;
            color: #3949ab;
        }

        .alert {
            margin: 1rem;
            padding: 1rem 1.5rem;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 10px;
            animation: slideIn 0.3s ease;
        }

        .alert-success {
            background: #4caf50;
            color: white;
            border-left: 4px solid #2e7d32;
        }

        .alert-error {
            background: #f44336;
            color: white;
            border-left: 4px solid #c62828;
        }

        .alert i {
            font-size: 1.2rem;
        }

        .unarchive-btn {
            background: linear-gradient(135deg, #4caf50, #2e7d32);
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 6px;
            font-weight: 600;
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'Kumbh Sans', sans-serif;
        }

        .unarchive-btn:hover {
            background: linear-gradient(135deg, #43a047, #1b5e20);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(76, 175, 80, 0.3);
        }

        .unarchive-btn:active {
            transform: translateY(0);
        }

        .no-results {
            text-align: center;
            padding: 3rem 1rem;
            color: #666;
            font-style: italic;
        }

        form {
            margin: 0;
            display: inline;
        }

        .card {
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            overflow: hidden;
            margin-bottom: 2rem;
        }

        .card-header {
            padding: 1.5rem;
            border-bottom: 1px solid #eee;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .card-header-content h2 {
            margin: 0 0 0.25rem 0;
            color: #2c3e50;
            font-size: 1.5rem;
        }

        .card-header-content span {
            color: #666;
            font-size: 0.9rem;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        table th {
            background: #f8f9fa;
            padding: 1rem;
            text-align: left;
            font-weight: 600;
            color: #2c3e50;
            border-bottom: 2px solid #eee;
        }

        table td {
            padding: 1rem;
            border-bottom: 1px solid #eee;
            color: #333;
        }

        table tr:hover {
            background: #f8f9fa;
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <svg class="logo-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15 15">
                    <path fill="currentColor" d="M1.082 9.939C.987 9.867 1 9.748 1 9.748L1.526 3.5s.008-.069.039-.104c.019-.022.043-.054.09-.073C2.182 3.107 5.053 1.552 6.5 3c.24.278.5.688.5 1v5.288s.006.112-.095.18a.25.25 0 0 1-.242.003c-2.226-1.114-4.711.154-5.338.487a.22.22 0 0 1-.243-.02m12.593.019c-.627-.333-3.112-1.6-5.338-.487a.25.25 0 0 1-.242-.003C7.994 9.4 8 9.288 8 9.288V4c0-.312.26-.722.5-1c1.446-1.448 4.3.107 4.827.323c.046.019.07.051.09.073c.03.035.039.104.039.104l.543 6.248s.014.119-.08.19a.22.22 0 0 1-.244.02m-4.81 2.728a.24.24 0 0 0 .118-.077a.2.2 0 0 0 .042-.109c.05-.938 1.624-1.812 4.648-.03c.077.044.166.04.242-.015c.086-.063.085-.17.085-.17v-.553s0-.077-.027-.119a.23.23 0 0 0-.093-.085c-2.025-1.315-4.586-1.898-5.885-.16a.2.2 0 0 1-.073.09c-.057.045-.126.042-.126.042h-.585s-.07.003-.126-.041a.2.2 0 0 1-.073-.09c-1.3-1.739-3.86-1.184-5.885.131a.23.23 0 0 0-.093.086c-.027.042-.027.118-.027.118v.554s-.001.107.085.17a.22.22 0 0 0 .243.015c3.023-1.782 4.598-.88 4.647.057a.2.2 0 0 0 .043.109a.24.24 0 0 0 .118.077c.721.18 1.768.25 2.722 0" />
                </svg>
                <h2 class="logo">Li<span>Book</span></h2>
            </div>
            <button class="close-btn" id="closeSidebar">
                <i class="fas fa-times"></i>
            </button>
            <button class="menu-toggle-sidebar desktop-only" id="sidebarToggleDesktop">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <nav class="sidebar-nav">
            <a href="@Url.Action("Index", "AdminDashboard")" class="nav-item" data-page="dashboard">
                <i class="fas fa-home"></i>
                <span>Dashboard</span>
            </a>
            <a href="@Url.Action("Reservations", "AdminDashboard")" class="nav-item" data-page="reservations">
                <i class="fas fa-calendar-check"></i>
                <span>Reservations</span>
            </a>
            <a href="@Url.Action("Librarian", "AdminDashboard")" class="nav-item" data-page="librarian">
                <i class="fas fa-user-tie"></i>
                <span>User Management</span>
            </a>
            <a href="@Url.Action("Rooms", "AdminDashboard")" class="nav-item" data-page="rooms">
                <i class="fas fa-door-open"></i>
                <span>Manage Rooms</span>
            </a>
            <a href="@Url.Action("Archives", "AdminDashboard")" class="nav-item active" data-page="archives">
                <i class="fas fa-archive"></i>
                <span>Archives</span>
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navigation -->
        <header class="topbar">
            <div class="topbar-left">
                <button class="menu-toggle mobile-only" id="menuToggle">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <div class="content-header">
                <h1>Archives</h1>
                <p>View and manage archived data by category.</p>
            </div>

            <div class="topbar-actions">
                <div class="user-profile" id="userProfile">
                    <img src="https://ui-avatars.com/api/?name=Admin+User&background=c62828&color=fff" alt="Admin">
                    <div class="user-info">
                        <span class="user-name">ADMINISTRATOR</span>
                        <span class="user-role">System Administrator</span>
                    </div>
                    <i class="fas fa-chevron-down dropdown-arrow"></i>

                    <!-- User Dropdown Menu -->
                    <div class="user-dropdown" id="userDropdown">
                        <div class="dropdown-divider"></div>
                        @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm" }))
                        {
                            @Html.AntiForgeryToken()
                            <a href="#" class="dropdown-item logout" onclick="document.getElementById('logoutForm').submit()">
                                <i class="fas fa-sign-out-alt"></i>
                                <span>Logout</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </header>

        <!-- Success/Error Messages -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-error">
                <i class="fas fa-exclamation-circle"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
        }

        <div class="archives-container">
            <!-- Tabs -->
            <div class="tabs">
                <button class="tab active" data-target="rooms">Rooms</button>
                <button class="tab" data-target="reservations">Canceled Reservations</button>
                <button class="tab" data-target="users">Users</button>
            </div>

            <!-- Rooms Tab -->
            <div class="tab-content active" id="rooms">
                <div class="card">
                    <div class="card-header">
                        <div class="card-header-content">
                            <h2>Archived Rooms</h2>
                            <span>@ViewBag.ArchivedRooms.Count Records</span>
                        </div>
                        <div class="table-search-container">
                            <i class="fas fa-search"></i>
                            <input type="text" class="table-search" placeholder="Search rooms..." data-table="rooms-table">
                        </div>
                    </div>
                    @if (ViewBag.ArchivedRooms.Count > 0)
                    {
                        <table id="rooms-table">
                            <thead>
                                <tr>
                                    <th>Room Name</th>
                                    <th>Type</th>
                                    <th>Capacity</th>
                                    <th>Status</th>
                                    <th>Archived Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var room in ViewBag.ArchivedRooms)
                                {
                                    <tr>
                                        <td>@room.RoomName</td>
                                        <td>@room.RoomType</td>
                                        <td>@room.Capacity</td>
                                        <td>
                                            <span class="status archived">
                                                Archived
                                                @if (room.Availability != null)
                                                {
                                                    <br /><small>(@room.Availability)</small>
                                                }
                                            </span>
                                        </td>
                                        <td>@(room.DateArchived?.ToString("MMM dd, yyyy") ?? "Unknown")</td>
                                        <td>
                                            @using (Html.BeginForm("RestoreRoom", "AdminDashboard", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@room.ID" />
                                                <button type="submit" class="unarchive-btn">
                                                    <i class="fas fa-undo-alt"></i> Restore
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="no-results">
                            <i class="fas fa-door-closed" style="font-size: 3rem; color: #ccc; margin-bottom: 1rem;"></i>
                            <h3>No Archived Rooms</h3>
                            <p>There are currently no archived rooms in the system.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Reservations Tab -->
            <div class="tab-content" id="reservations">
                <div class="card">
                    <div class="card-header">
                        <div class="card-header-content">
                            <h2>Canceled Reservations</h2>
                            <span>@ViewBag.CancelledBookings.Count Records</span>
                        </div>
                        <div class="table-search-container">
                            <i class="fas fa-search"></i>
                            <input type="text" class="table-search" placeholder="Search reservations..." data-table="reservations-table">
                        </div>
                    </div>
                    @if (ViewBag.CancelledBookings.Count > 0)
                    {
                        <table id="reservations-table">
                            <thead>
                                <tr>
                                    <th>Reservation ID</th>
                                    <th>Room</th>
                                    <th>Reservee</th>
                                    <th>Date</th>
                                    <th>Cancelled Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var booking in ViewBag.CancelledBookings)
                                {
                                    var roomName = booking.Room?.RoomName ?? "N/A";
                                    var reserveeName = $"{booking.ReserveeFirstName} {booking.ReserveeLastName}";
                                    if (!string.IsNullOrEmpty(booking.ReserveeSuffix))
                                    {
                                        reserveeName += $" {booking.ReserveeSuffix}";
                                    }

                                    <tr>
                                        <td>#@booking.ID.ToString("D4")</td>
                                        <td>@roomName</td>
                                        <td>@reserveeName</td>
                                        <td>@booking.BookingDate.ToString("MMM dd, yyyy")</td>
                                        <td>@(booking.CancelledAt?.ToString("MMM dd, yyyy") ?? "Unknown")</td>
                                        <td>
                                            @using (Html.BeginForm("ApproveBooking", "AdminDashboard", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@booking.ID" />
                                                <button type="submit" class="unarchive-btn">
                                                    <i class="fas fa-check-circle"></i> Approve
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="no-results">
                            <i class="fas fa-calendar-times" style="font-size: 3rem; color: #ccc; margin-bottom: 1rem;"></i>
                            <h3>No Cancelled Reservations</h3>
                            <p>There are currently no cancelled reservations in the system.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Users Tab -->
            <div class="tab-content" id="users">
                <div class="card">
                    <div class="card-header">
                        <div class="card-header-content">
                            <h2>Archived Users</h2>
                            <span>@ViewBag.ArchivedUsers.Count Records</span>
                        </div>
                        <div class="table-search-container">
                            <i class="fas fa-search"></i>
                            <input type="text" class="table-search" placeholder="Search users..." data-table="users-table">
                        </div>
                    </div>
                    @if (ViewBag.ArchivedUsers.Count > 0)
                    {
                        <table id="users-table">
                            <thead>
                                <tr>
                                    <th>Full Name</th>
                                    <th>Email</th>
                                    <th>Account Status</th>
                                    <th>Archived Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in ViewBag.ArchivedUsers)
                                {
                                    var fullName = $"{user.FirstName} {user.LastName}";
                                    if (!string.IsNullOrEmpty(user.MiddleName))
                                    {
                                        fullName += $" {user.MiddleName}";
                                    }
                                    if (!string.IsNullOrEmpty(user.Suffix))
                                    {
                                        fullName += $" {user.Suffix}";
                                    }

                                    <tr>
                                        <td>@fullName</td>
                                        <td>@user.Email</td>
                                        <td>
                                            <span class="status inactive">
                                                @user.AccountStatus
                                            </span>
                                        </td>
                                        <td>@(user.DateArchived?.ToString("MMM dd, yyyy") ?? "Unknown")</td>
                                        <td>
                                            @using (Html.BeginForm("RestoreUser", "AdminDashboard", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@user.ID" />
                                                <button type="submit" class="unarchive-btn">
                                                    <i class="fas fa-user-plus"></i> Restore
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="no-results">
                            <i class="fas fa-user-slash" style="font-size: 3rem; color: #ccc; margin-bottom: 1rem;"></i>
                            <h3>No Archived Users</h3>
                            <p>There are currently no archived users in the system.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <script src="~/Scripts/archives.js"></script>
</body>
</html>