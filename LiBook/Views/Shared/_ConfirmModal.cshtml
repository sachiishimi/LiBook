<style>
    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(100, 100, 100, 0.8);
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .modal-box {
        background-image: linear-gradient(130deg, white 50%, rgba(255,255,255,0) 50%), url('/Content/images/modalbg.jpg');
        background-repeat: no-repeat;
        background-size: cover; /* makes the image cover the container */
        background-blend-mode: overlay; /* optional, if you want gradient blending */
        padding: 20px 30px;
        border-radius: 15px;
        max-width: 650px;
        width: 90%;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

        .modal-box h3 {
            color: #000;
            font-size: 32px;
            font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;
            color: #031C29;
            text-transform: uppercase;
            font-weight: 1000;
            margin: 0 0 8px 0;
            letter-spacing: 0.5px;
            padding-bottom: 12px;
            border-bottom: 5px solid #000;
            width: fit-content;
        }

    .modal-header-text {
        color: #0d5fa8;
        font-size: 15px;
        margin: 15px 0 30px 0;
        font-weight: 600;
    }

    #modalContent {
        color: #000;
        font-size: 17px;
        line-height: 2;
    }

        #modalContent .info-row {
            display: grid;
            grid-template-columns: 200px 1fr;
            margin-bottom: 12px;
            align-items: baseline;
        }

        #modalContent .info-label {
            font-weight: 700;
            color: #031C29;
        }

        #modalContent .info-value {
            font-weight: 400;
            color: #000;
        }

    .modal-actions {
        display: flex;
        gap: 20px;
        justify-content: flex-end;
        margin-top: 35px;
    }

    .btn {
        padding: 14px 20px;
        border: none;
        border-radius: 5px;
        font-size: 16px;
        font-weight: 800;
        cursor: pointer;
        transition: all 0.2s ease;
        font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;
        letter-spacing: 1px;
    }

    .btn-cancel {
        background: #1E9BE8;
        color: #fff;
    }

        .btn-cancel:hover {
            background: #1a88d1;
        }

    .btn-confirm {
        background: #3d4a54;
        color: #F89104;
    }

        .btn-confirm:hover {
            background: #2d3740;
        }
</style>

<div id="confirmModal" class="modal-overlay">
    <div class="modal-box">
        <h3>@ViewBag.Title Preview</h3>
        <p class="modal-header-text">Please check your form carefully.</p>
        <div id="modalContent">
            <!-- Content will be injected here by JavaScript -->
        </div>
        <div class="modal-actions">
            <button id="closeModalBtn" class="btn btn-cancel">Edit</button>
            <button id="confirmSubmitBtn" class="btn btn-confirm">Submit</button>
        </div>
    </div>
</div>