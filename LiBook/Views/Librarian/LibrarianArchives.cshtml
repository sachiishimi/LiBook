﻿@model List<LiBook.Controllers.LibrarianController.ArchiveReservationViewModel>
@{
    ViewBag.Title = "Archives";
    var statusFilter = ViewBag.StatusFilter as string ?? "successful";
    var dateFilter = ViewBag.DateFilter as string ?? "all";
    var userTypeFilter = ViewBag.UserTypeFilter as string ?? "all";

    // Statistics
    var successfulCount = ViewBag.SuccessfulCount != null ? (int)ViewBag.SuccessfulCount : 0;
    var cancelledCount = ViewBag.CancelledCount != null ? (int)ViewBag.CancelledCount : 0;
    var successfulToday = ViewBag.SuccessfulToday != null ? (int)ViewBag.SuccessfulToday : 0;
    var cancelledToday = ViewBag.CancelledToday != null ? (int)ViewBag.CancelledToday : 0;

    // Get reservations from Model (not ViewBag)
    var archivedReservations = Model;

    // Helper function to format time
    Func<TimeSpan, string> FormatTime = (time) =>
    {
        var hours = time.Hours;
        var minutes = time.Minutes;
        var ampm = hours >= 12 ? "PM" : "AM";
        var displayHour = hours % 12;
        if (displayHour == 0) displayHour = 12;
        return $"{displayHour}:{minutes:D2} {ampm}";
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - LiBook</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@100..900&family=League+Spartan:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="~/Content/librarianarchives.css" rel="stylesheet" />
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <svg class="logo-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15 15">
                    <path fill="currentColor" d="M1.082 9.939C.987 9.867 1 9.748 1 9.748L1.526 3.5s.008-.069.039-.104c.019-.022.043-.054.09-.073C2.182 3.107 5.053 1.552 6.5 3c.24.278.5.688.5 1v5.288s.006.112-.095.18a.25.25 0 0 1-.242.003c-2.226-1.114-4.711.154-5.338.487a.22.22 0 0 1-.243-.02m12.593.019c-.627-.333-3.112-1.6-5.338-.487a.25.25 0 0 1-.242-.003C7.994 9.4 8 9.288 8 9.288V4c0-.312.26-.722.5-1c1.446-1.448 4.3.107 4.827.323c.046.019.07.051.09.073c.03.035.039.104.039.104l.543 6.248s.014.119-.08.19a.22.22 0 0 1-.244.02m-4.81 2.728a.24.24 0 0 0 .118-.077a.2.2 0 0 0 .042-.109c.05-.938 1.624-1.812 4.648-.03c.077.044.166.04.242-.015c.086-.063.085-.17.085-.17v-.553s0-.077-.027-.119a.23.23 0 0 0-.093-.085c-2.025-1.315-4.586-1.898-5.885-.16a.2.2 0 0 1-.073.09c-.057.045-.126.042-.126.042h-.585s-.07.003-.126-.041a.2.2 0 0 1-.073-.09c-1.3-1.739-3.86-1.184-5.885.131a.23.23 0 0 0-.093.086c-.027.042-.027.118-.027.118v.554s-.001.107.085.17a.22.22 0 0 0 .243.015c3.023-1.782 4.598-.88 4.647.057a.2.2 0 0 0 .043.109a.24.24 0 0 0 .118.077c.721.18 1.768.25 2.722 0" />
                </svg>
                <h2 class="logo">Li<span>Book</span></h2>
            </div>
            <button class="close-btn" id="closeSidebar">
                <i class="fas fa-times"></i>
            </button>
            <button class="menu-toggle-sidebar desktop-only" id="sidebarToggleDesktop">
                <i class="fas fa-bars"></i>
            </button>
        </div>
        <nav class="sidebar-nav">
            <a href="@Url.Action("LibrarianDashboard", "Librarian")" class="nav-item" data-page="dashboard">
                <i class="fas fa-home"></i>
                <span>Dashboard</span>
            </a>
            <a href="@Url.Action("LibrarianReservations", "Librarian")" class="nav-item" data-page="reservations">
                <i class="fas fa-calendar-check"></i>
                <span>Reservations</span>
            </a>
            <a href="@Url.Action("RoomManagement", "Librarian")" class="nav-item" data-page="rooms">
                <i class="fas fa-door-open"></i>
                <span>Room Management</span>
            </a>
            <a href="@Url.Action("LibrarianArchives", "Librarian")" class="nav-item active" data-page="archives">
                <i class="fas fa-archive"></i>
                <span>Archives</span>
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navigation -->
        <header class="topbar">
            <div class="topbar-left">
                <button class="menu-toggle mobile-only" id="menuToggle">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <div class="page-header">
                <h1 class="page-title">Archives</h1>
                <p class="page-description">View and manage archived reservations and historical data</p>
            </div>

            <div class="topbar-actions">
                <button class="icon-btn notification-btn">
                    <i class="fas fa-bell"></i>
                    <span class="badge">3</span>
                </button>
                <div class="user-profile" id="userProfile">
                    <img src="https://ui-avatars.com/api/?name=Librarian&background=2c3e50&color=fff" alt="Librarian">
                    <div class="user-info">
                        <span class="user-name">LIBRARIAN</span>
                        <span class="user-role">Library Staff</span>
                    </div>
                    <i class="fas fa-chevron-down dropdown-arrow"></i>

                    <!-- User Dropdown Menu -->
                    <div class="user-dropdown" id="userDropdown">
                        <a href="#" class="dropdown-item">
                            <i class="fas fa-user-cog"></i>
                            <span>Settings</span>
                        </a>
                        <a href="#" class="dropdown-item">
                            <i class="fas fa-question-circle"></i>
                            <span>Help & Support</span>
                        </a>
                        <div class="dropdown-divider"></div>
                        @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm" }))
                        {
                            @Html.AntiForgeryToken()
                            <a href="#" class="dropdown-item logout" id="logoutButton">
                                <i class="fas fa-sign-out-alt"></i>
                                <span>Logout</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </header>

        <!-- Dashboard Content -->
        <main class="content">
            <!-- Tabs Navigation -->
            <div class="tabs-container">
                <div class="tabs-nav">
                    <!-- Successful Reservations Tab Button -->
                    @if (statusFilter == "successful")
                    {
                        <button class="tab-btn active" onclick="submitStatusFilter('successful')">
                            <i class="fas fa-check-circle"></i>
                            <span>Successful Reservations</span>
                            <span class="tab-badge">@successfulCount</span>
                        </button>
                    }
                    else
                    {
                        <button class="tab-btn" onclick="submitStatusFilter('successful')">
                            <i class="fas fa-check-circle"></i>
                            <span>Successful Reservations</span>
                            <span class="tab-badge">@successfulCount</span>
                        </button>
                    }

                    <!-- Cancelled Reservations Tab Button -->
                    @if (statusFilter == "cancelled")
                    {
                        <button class="tab-btn active" onclick="submitStatusFilter('cancelled')">
                            <i class="fas fa-times-circle"></i>
                            <span>Cancelled Reservations</span>
                            <span class="tab-badge">@cancelledCount</span>
                        </button>
                    }
                    else
                    {
                        <button class="tab-btn" onclick="submitStatusFilter('cancelled')">
                            <i class="fas fa-times-circle"></i>
                            <span>Cancelled Reservations</span>
                            <span class="tab-badge">@cancelledCount</span>
                        </button>
                    }
                </div>

                <!-- Main Filter Form -->
                @using (Html.BeginForm("FilterArchives", "Librarian", FormMethod.Get, new { id = "mainFilterForm" }))
                {
                    <input type="hidden" name="statusFilter" id="statusFilterInput" value="@statusFilter" />
                    <input type="hidden" name="dateFilter" id="dateFilterInput" value="@dateFilter" />
                    <input type="hidden" name="userTypeFilter" id="userTypeFilterInput" value="@userTypeFilter" />
                }

                <!-- Successful Reservations Tab Content -->
                @if (statusFilter == "successful")
                {
                    <div class="tab-content active" id="successful-tab">
                        <div class="table-controls">
                            <div class="search-box">
                                <i class="fas fa-search"></i>
                                <input type="text" id="successfulSearch" placeholder="Search reservations..."
                                       onkeyup="filterTable('successful', this.value)">
                            </div>
                            <div class="filter-group">
                                <select class="filter-select" id="successfulUserTypeFilter" onchange="updateUserTypeFilter(this.value)">
                                    <option value="all" @(userTypeFilter == "all" ? "selected" : "")>All Users</option>
                                    <option value="Student" @(userTypeFilter == "Student" ? "selected" : "")>Student</option>
                                    <option value="Faculty" @(userTypeFilter == "Faculty" ? "selected" : "")>Faculty</option>
                                    <option value="Admin" @(userTypeFilter == "Admin" ? "selected" : "")>Admin</option>
                                    <option value="Visitor" @(userTypeFilter == "Visitor" ? "selected" : "")>Visitor</option>
                                </select>
                                <select class="filter-select" id="successfulDateFilter" onchange="updateDateFilter(this.value)">
                                    <option value="all" @(dateFilter == "all" ? "selected" : "")>All Time</option>
                                    <option value="today" @(dateFilter == "today" ? "selected" : "")>Today</option>
                                    <option value="week" @(dateFilter == "week" ? "selected" : "")>This Week</option>
                                    <option value="month" @(dateFilter == "month" ? "selected" : "")>This Month</option>
                                </select>
                            </div>
                        </div>

                        <!-- 3 Stat Cards -->
                        <div class="stats-cards">
                            <div class="stat-card success">
                                <div class="stat-icon">
                                    <i class="fas fa-book-open"></i>
                                </div>
                                <div class="stat-info">
                                    <h3 id="successful-total-count">@successfulCount</h3>
                                    <p>Total Successful Reservations</p>
                                </div>
                            </div>

                            <div class="stat-card clickable-stat @(dateFilter == "all" ? "active-filter" : "")"
                                 onclick="setDateFilter('all')" data-filter="all" data-tab="successful">
                                <div class="stat-icon">
                                    <i class="fas fa-calendar-check"></i>
                                </div>
                                <div class="stat-info">
                                    <h3 id="successful-filtered-count">
                                        @(archivedReservations != null ? archivedReservations.Count : 0)
                                    </h3>
                                    <p id="successful-filtered-label">
                                        @(dateFilter == "all" ? "All Time" :
                                          dateFilter == "today" ? "Today" :
                                          dateFilter == "week" ? "This Week" :
                                          dateFilter == "month" ? "This Month" : "All Time")
                                    </p>
                                </div>
                            </div>

                            <div class="stat-card">
                                <div class="stat-icon">
                                    <i class="fas fa-calendar-day"></i>
                                </div>
                                <div class="stat-info">
                                    <h3 id="successful-today-count">@successfulToday</h3>
                                    <p>Completed Today</p>
                                </div>
                            </div>
                        </div>

                        <div class="table-wrapper">
                            @if (archivedReservations != null && archivedReservations.Any())
                            {
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Name</th>
                                            <th>User Type</th>
                                            <th>Date</th>
                                            <th>Time</th>
                                            <th>Room</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var reservation in archivedReservations)
                                        {
                                            <tr data-user-type="@reservation.UserType" data-reservation-id="@reservation.ID">
                                                <td>@reservation.ReservationID</td>
                                                <td>
                                                    <div class="user-cell">
                                                        <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(reservation.ReserveeName)&background=random&color=fff"
                                                             alt="@reservation.ReserveeName"
                                                             class="user-avatar">
                                                        <span>@reservation.ReserveeName</span>
                                                    </div>
                                                </td>
                                                <td><div class="user-type-cell"><strong>@reservation.UserType</strong></div></td>
                                                <td>@reservation.BookingDate.ToString("MMM dd, yyyy")</td>
                                                <td>@FormatTime(reservation.StartTime) - @FormatTime(reservation.EndTime)</td>
                                                <td>@reservation.RoomName</td>
                                                <td><span class="badge-status success">@reservation.Status</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="empty-state">
                                    <i class="fas fa-calendar-check"></i>
                                    <h3>No Successful Reservations</h3>
                                    <p>Completed reservations will appear here after their scheduled time has passed</p>
                                </div>
                            }
                        </div>

                        @if (archivedReservations != null && archivedReservations.Any())
                        {
                            <div class="pagination">
                                <button class="pagination-btn" disabled><i class="fas fa-chevron-left"></i></button>
                                <button class="pagination-btn active">1</button>
                                <button class="pagination-btn">2</button>
                                <button class="pagination-btn"><i class="fas fa-chevron-right"></i></button>
                            </div>
                        }
                    </div>
                }

                <!-- Cancelled Reservations Tab Content -->
                @if (statusFilter == "cancelled")
                {
                    <div class="tab-content active" id="cancelled-tab">
                        <div class="table-controls">
                            <div class="search-box">
                                <i class="fas fa-search"></i>
                                <input type="text" id="cancelledSearch" placeholder="Search reservations..."
                                       onkeyup="filterTable('cancelled', this.value)">
                            </div>
                            <div class="filter-group">
                                <select class="filter-select" id="cancelledUserTypeFilter" onchange="updateUserTypeFilter(this.value)">
                                    <option value="all" @(userTypeFilter == "all" ? "selected" : "")>All Users</option>
                                    <option value="Student" @(userTypeFilter == "Student" ? "selected" : "")>Student</option>
                                    <option value="Faculty" @(userTypeFilter == "Faculty" ? "selected" : "")>Faculty</option>
                                    <option value="Admin" @(userTypeFilter == "Admin" ? "selected" : "")>Admin</option>
                                    <option value="Visitor" @(userTypeFilter == "Visitor" ? "selected" : "")>Visitor</option>
                                </select>
                                <select class="filter-select" id="cancelledDateFilter" onchange="updateDateFilter(this.value)">
                                    <option value="all" @(dateFilter == "all" ? "selected" : "")>All Time</option>
                                    <option value="today" @(dateFilter == "today" ? "selected" : "")>Today</option>
                                    <option value="week" @(dateFilter == "week" ? "selected" : "")>This Week</option>
                                    <option value="month" @(dateFilter == "month" ? "selected" : "")>This Month</option>
                                </select>
                            </div>
                        </div>

                        <!-- 3 Stat Cards -->
                        <div class="stats-cards">
                            <div class="stat-card danger">
                                <div class="stat-icon">
                                    <i class="fas fa-times-circle"></i>
                                </div>
                                <div class="stat-info">
                                    <h3 id="cancelled-total-count">@cancelledCount</h3>
                                    <p>Total Cancellations</p>
                                </div>
                            </div>

                            <div class="stat-card clickable-stat @(dateFilter == "all" ? "active-filter" : "")"
                                 onclick="setDateFilter('all')" data-filter="all" data-tab="cancelled">
                                <div class="stat-icon">
                                    <i class="fas fa-calendar-times"></i>
                                </div>
                                <div class="stat-info">
                                    <h3 id="cancelled-filtered-count">
                                        @(archivedReservations != null ? archivedReservations.Count : 0)
                                    </h3>
                                    <p id="cancelled-filtered-label">
                                        @(dateFilter == "all" ? "All Time" :
                                          dateFilter == "today" ? "Today" :
                                          dateFilter == "week" ? "This Week" :
                                          dateFilter == "month" ? "This Month" : "All Time")
                                    </p>
                                </div>
                            </div>

                            <div class="stat-card">
                                <div class="stat-icon">
                                    <i class="fas fa-calendar-day"></i>
                                </div>
                                <div class="stat-info">
                                    <h3 id="cancelled-today-count">@cancelledToday</h3>
                                    <p>Cancelled Today</p>
                                </div>
                            </div>
                        </div>

                        <div class="table-wrapper">
                            @if (archivedReservations != null && archivedReservations.Any())
                            {
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Name</th>
                                            <th>User Type</th>
                                            <th>Date</th>
                                            <th>Time</th>
                                            <th>Room</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var reservation in archivedReservations)
                                        {
                                            <tr data-user-type="@reservation.UserType" data-reservation-id="@reservation.ID">
                                                <td>@reservation.ReservationID</td>
                                                <td>
                                                    <div class="user-cell">
                                                        <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(reservation.ReserveeName)&background=random&color=fff"
                                                             alt="@reservation.ReserveeName"
                                                             class="user-avatar">
                                                        <span>@reservation.ReserveeName</span>
                                                    </div>
                                                </td>
                                                <td><div class="user-type-cell"><strong>@reservation.UserType</strong></div></td>
                                                <td>@reservation.BookingDate.ToString("MMM dd, yyyy")</td>
                                                <td>@FormatTime(reservation.StartTime) - @FormatTime(reservation.EndTime)</td>
                                                <td>@reservation.RoomName</td>
                                                <td><span class="badge-status cancelled">@reservation.Status</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="empty-state">
                                    <i class="fas fa-ban"></i>
                                    <h3>No Cancelled Reservations</h3>
                                    <p>Cancelled reservations will appear here</p>
                                </div>
                            }
                        </div>

                        @if (archivedReservations != null && archivedReservations.Any())
                        {
                            <div class="pagination">
                                <button class="pagination-btn" disabled><i class="fas fa-chevron-left"></i></button>
                                <button class="pagination-btn active">1</button>
                                <button class="pagination-btn">2</button>
                                <button class="pagination-btn"><i class="fas fa-chevron-right"></i></button>
                            </div>
                        }
                    </div>
                }
            </div>
        </main>
    </div>

    <script src="~/Scripts/librarianarchives.js"></script>

    <script>
        // Filter functions
        function submitStatusFilter(status) {
            document.getElementById('statusFilterInput').value = status;
            document.getElementById('mainFilterForm').submit();
        }

        function updateDateFilter(dateFilter) {
            document.getElementById('dateFilterInput').value = dateFilter;
            document.getElementById('mainFilterForm').submit();
        }

        function updateUserTypeFilter(userTypeFilter) {
            document.getElementById('userTypeFilterInput').value = userTypeFilter;
            document.getElementById('mainFilterForm').submit();
        }

        function setDateFilter(dateFilter) {
            document.getElementById('dateFilterInput').value = dateFilter;
            document.getElementById('mainFilterForm').submit();
        }

        // Client-side table filtering
        function filterTable(tabType, searchTerm) {
            const table = document.querySelector(`#${tabType}-tab .data-table tbody`);
            if (!table) return;

            const rows = table.querySelectorAll('tr[data-reservation-id]');
            const term = searchTerm.toLowerCase();

            let visibleCount = 0;
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                if (text.includes(term)) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            // Show empty state if no results
            const emptyState = table.closest('.table-wrapper').querySelector('.empty-state');
            if (visibleCount === 0 && term !== '') {
                if (!emptyState) {
                    const tableWrapper = table.closest('.table-wrapper');
                    const emptyHtml = `
                            <div class="empty-state">
                                <i class="fas fa-search"></i>
                                <h3>No Results Found</h3>
                                <p>No reservations match your search: "${term}"</p>
                            </div>
                        `;
                    tableWrapper.innerHTML = emptyHtml;
                }
            } else if (visibleCount > 0 && emptyState) {
                // Remove empty state if we have results
                emptyState.remove();
                const tableWrapper = table.closest('.table-wrapper');
                if (tableWrapper.innerHTML.includes('empty-state')) {
                    location.reload(); // Reload to show table again
                }
            }
        }

        // Initialize search functionality
        document.addEventListener('DOMContentLoaded', function () {
            const successfulSearch = document.getElementById('successfulSearch');
            const cancelledSearch = document.getElementById('cancelledSearch');

            if (successfulSearch) {
                successfulSearch.addEventListener('input', function (e) {
                    filterTable('successful', e.target.value);
                });
            }

            if (cancelledSearch) {
                cancelledSearch.addEventListener('input', function (e) {
                    filterTable('cancelled', e.target.value);
                });
            }
        });
    </script>
</body>
</html>