
@{
    ViewBag.Title = "LibrarianArchives";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - LiBook</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@100..900&family=League+Spartan:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="~/Content/librarianarchives.css" rel="stylesheet" />
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <svg class="logo-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15 15">
                    <path fill="currentColor" d="M1.082 9.939C.987 9.867 1 9.748 1 9.748L1.526 3.5s.008-.069.039-.104c.019-.022.043-.054.09-.073C2.182 3.107 5.053 1.552 6.5 3c.24.278.5.688.5 1v5.288s.006.112-.095.18a.25.25 0 0 1-.242.003c-2.226-1.114-4.711.154-5.338.487a.22.22 0 0 1-.243-.02m12.593.019c-.627-.333-3.112-1.6-5.338-.487a.25.25 0 0 1-.242-.003C7.994 9.4 8 9.288 8 9.288V4c0-.312.26-.722.5-1c1.446-1.448 4.3.107 4.827.323c.046.019.07.051.09.073c.03.035.039.104.039.104l.543 6.248s.014.119-.08.19a.22.22 0 0 1-.244.02m-4.81 2.728a.24.24 0 0 0 .118-.077a.2.2 0 0 0 .042-.109c.05-.938 1.624-1.812 4.648-.03c.077.044.166.04.242-.015c.086-.063.085-.17.085-.17v-.553s0-.077-.027-.119a.23.23 0 0 0-.093-.085c-2.025-1.315-4.586-1.898-5.885-.16a.2.2 0 0 1-.073.09c-.057.045-.126.042-.126.042h-.585s-.07.003-.126-.041a.2.2 0 0 1-.073-.09c-1.3-1.739-3.86-1.184-5.885.131a.23.23 0 0 0-.093.086c-.027.042-.027.118-.027.118v.554s-.001.107.085.17a.22.22 0 0 0 .243.015c3.023-1.782 4.598-.88 4.647.057a.2.2 0 0 0 .043.109a.24.24 0 0 0 .118.077c.721.18 1.768.25 2.722 0" />
                </svg>
                <h2 class="logo">Li<span>Book</span></h2>
            </div>
            <button class="close-btn" id="closeSidebar">
                <i class="fas fa-times"></i>
            </button>
            <button class="menu-toggle-sidebar desktop-only" id="sidebarToggleDesktop">
                <i class="fas fa-bars"></i>
            </button>
        </div>
        <nav class="sidebar-nav">
            <a href="@Url.Action("LibrarianDashboard", "Librarian")" class="nav-item" data-page="dashboard">
                <i class="fas fa-home"></i>
                <span>Dashboard</span>
            </a>
            <a href="@Url.Action("LibrarianReservations", "Librarian")" class="nav-item" data-page="reservations">
                <i class="fas fa-calendar-check"></i>
                <span>Reservations</span>
            </a>
            <a href="@Url.Action("RoomManagement", "Librarian")" class="nav-item" data-page="rooms">
                <i class="fas fa-door-open"></i>
                <span>Room Management</span>
            </a>
            <a href="@Url.Action("LibrarianArchives", "Librarian")" class="nav-item active" data-page="archives">
                <i class="fas fa-archive"></i>
                <span>Archives</span>
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navigation -->
        <header class="topbar">
            <div class="topbar-left">
                <button class="menu-toggle mobile-only" id="menuToggle">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <div class="page-header">
                <h1 class="page-title">Archives</h1>
                <p class="page-description">View and manage archived reservations and historical data</p>
            </div>

            <div class="topbar-actions">
                <button class="icon-btn notification-btn">
                    <i class="fas fa-bell"></i>
                    <span class="badge">3</span>
                </button>
                <div class="user-profile" id="userProfile">
                    <img src="https://ui-avatars.com/api/?name=Librarian&background=2c3e50&color=fff" alt="Librarian">
                    <div class="user-info">
                        <span class="user-name">LIBRARIAN</span>
                        <span class="user-role">Library Staff</span>
                    </div>
                    <i class="fas fa-chevron-down dropdown-arrow"></i>

                    <!-- User Dropdown Menu -->
                    <div class="user-dropdown" id="userDropdown">
                        <a href="#" class="dropdown-item">
                            <i class="fas fa-user-cog"></i>
                            <span>Settings</span>
                        </a>
                        <a href="#" class="dropdown-item">
                            <i class="fas fa-question-circle"></i>
                            <span>Help & Support</span>
                        </a>
                        <div class="dropdown-divider"></div>
                        @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm" }))
                        {
                            @Html.AntiForgeryToken()
                            <a href="#" class="dropdown-item logout" id="logoutButton">
                                <i class="fas fa-sign-out-alt"></i>
                                <span>Logout</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </header>

        <!-- Dashboard Content -->
        <main class="content">
            <!-- Tabs Navigation -->
            <div class="tabs-container">
                <div class="tabs-nav">
                    <button class="tab-btn active" data-tab="successful">
                        <i class="fas fa-check-circle"></i>
                        <span>Successful Reservations</span>
                    </button>
                    <button class="tab-btn" data-tab="cancelled">
                        <i class="fas fa-times-circle"></i>
                        <span>Cancelled Reservations</span>
                    </button>
                </div>

                <!-- Successful Reservations Tab Content -->
                <div class="tab-content active" id="successful-tab">
                    <div class="table-controls">
                        <div class="search-box">
                            <i class="fas fa-search"></i>
                            <input type="text" id="successfulSearch" placeholder="Search reservations...">
                        </div>
                        <div class="filter-group">
                            <select class="filter-select" id="successfulUserTypeFilter">
                                <option value="all">All Users</option>
                                <option value="Student">Student</option>
                                <option value="Faculty">Faculty</option>
                                <option value="Admin">Admin</option>
                                <option value="Visitor">Visitor</option>
                            </select>
                            <select class="filter-select" id="successfulDateFilter">
                                <option value="all">All Time</option>
                                <option value="today">Today</option>
                                <option value="week">This Week</option>
                                <option value="month">This Month</option>
                            </select>
                        </div>
                    </div>

                    <!-- 3 Stat Cards -->
                    <div class="stats-cards">
                        <div class="stat-card success">
                            <div class="stat-icon">
                                <i class="fas fa-book-open"></i>
                            </div>
                            <div class="stat-info">
                                <h3 id="successful-total-count">245</h3>
                                <p>Total Reservations</p>
                            </div>
                        </div>

                        <div class="stat-card clickable-stat active-filter" data-filter="all" data-tab="successful">
                            <div class="stat-icon">
                                <i class="fas fa-calendar-check"></i>
                            </div>
                            <div class="stat-info">
                                <h3 id="successful-filtered-count">245</h3>
                                <p id="successful-filtered-label">All Time</p>
                            </div>
                        </div>

                        <div class="stat-card">
                            <div class="stat-icon">
                                <i class="fas fa-calendar-day"></i>
                            </div>
                            <div class="stat-info">
                                <h3 id="successful-today-count">12</h3>
                                <p>Completed Today</p>
                            </div>
                        </div>
                    </div>

                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Name</th>
                                    <th>User Type</th>
                                    <th>Date</th>
                                    <th>Time</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr data-user-type="Student">
                                    <td>RES-101</td>
                                    <td><div class="user-cell"><span>John Smith</span></div></td>
                                    <td><div class="user-type-cell"><strong>Student</strong></div></td>
                                    <td>Nov 23, 2025</td>
                                    <td>9:00 AM - 11:00 AM</td>
                                    <td><span class="badge-status success">Complete</span></td>
                                </tr>
                                <tr data-user-type="Faculty">
                                    <td>RES-102</td>
                                    <td><div class="user-cell"><span>Sarah Johnson</span></div></td>
                                    <td><div class="user-type-cell"><strong>Faculty</strong></div></td>
                                    <td>Nov 23, 2025</td>
                                    <td>1:00 PM - 3:00 PM</td>
                                    <td><span class="badge-status success">Complete</span></td>
                                </tr>
                                <tr data-user-type="Student">
                                    <td>RES-103</td>
                                    <td><div class="user-cell"><span>Michael Lee</span></div></td>
                                    <td><div class="user-type-cell"><strong>Student</strong></div></td>
                                    <td>Nov 22, 2025</td>
                                    <td>2:00 PM - 4:00 PM</td>
                                    <td><span class="badge-status success">Complete</span></td>
                                </tr>
                                <tr data-user-type="Visitor">
                                    <td>RES-104</td>
                                    <td><div class="user-cell"><span>Emily Davis</span></div></td>
                                    <td><div class="user-type-cell"><strong>Visitor</strong></div></td>
                                    <td>Nov 21, 2025</td>
                                    <td>10:00 AM - 12:00 PM</td>
                                    <td><span class="badge-status success">Complete</span></td>
                                </tr>
                                <tr data-user-type="Admin">
                                    <td>RES-105</td>
                                    <td><div class="user-cell"><span>Robert Wilson</span></div></td>
                                    <td><div class="user-type-cell"><strong>Admin</strong></div></td>
                                    <td>Nov 20, 2025</td>
                                    <td>3:00 PM - 5:00 PM</td>
                                    <td><span class="badge-status success">Complete</span></td>
                                </tr>
                                <tr data-user-type="Student">
                                    <td>RES-106</td>
                                    <td><div class="user-cell"><span>Jessica Brown</span></div></td>
                                    <td><div class="user-type-cell"><strong>Student</strong></div></td>
                                    <td>Nov 19, 2025</td>
                                    <td>8:00 AM - 10:00 AM</td>
                                    <td><span class="badge-status success">Complete</span></td>
                                </tr>
                                <tr data-user-type="Faculty">
                                    <td>RES-107</td>
                                    <td><div class="user-cell"><span>David Martinez</span></div></td>
                                    <td><div class="user-type-cell"><strong>Faculty</strong></div></td>
                                    <td>Nov 18, 2025</td>
                                    <td>11:00 AM - 1:00 PM</td>
                                    <td><span class="badge-status success">Complete</span></td>
                                </tr>
                                <tr data-user-type="Student">
                                    <td>RES-108</td>
                                    <td><div class="user-cell"><span>Lisa Anderson</span></div></td>
                                    <td><div class="user-type-cell"><strong>Student</strong></div></td>
                                    <td>Nov 17, 2025</td>
                                    <td>4:00 PM - 6:00 PM</td>
                                    <td><span class="badge-status success">Complete</span></td>
                                </tr>
                                <tr data-user-type="Visitor">
                                    <td>RES-109</td>
                                    <td><div class="user-cell"><span>James Taylor</span></div></td>
                                    <td><div class="user-type-cell"><strong>Visitor</strong></div></td>
                                    <td>Nov 16, 2025</td>
                                    <td>9:30 AM - 11:30 AM</td>
                                    <td><span class="badge-status success">Complete</span></td>
                                </tr>
                                <tr data-user-type="Student">
                                    <td>RES-110</td>
                                    <td><div class="user-cell"><span>Maria Garcia</span></div></td>
                                    <td><div class="user-type-cell"><strong>Student</strong></div></td>
                                    <td>Nov 15, 2025</td>
                                    <td>1:30 PM - 3:30 PM</td>
                                    <td><span class="badge-status success">Complete</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="pagination">
                        <button class="pagination-btn" disabled><i class="fas fa-chevron-left"></i></button>
                        <button class="pagination-btn active">1</button>
                        <button class="pagination-btn">2</button>
                        <button class="pagination-btn"><i class="fas fa-chevron-right"></i></button>
                    </div>
                </div>

                <!-- Cancelled Reservations Tab Content -->
                <div class="tab-content" id="cancelled-tab">
                    <div class="table-controls">
                        <div class="search-box">
                            <i class="fas fa-search"></i>
                            <input type="text" id="cancelledSearch" placeholder="Search reservations...">
                        </div>
                        <div class="filter-group">
                            <select class="filter-select" id="cancelledUserTypeFilter">
                                <option value="all">All Users</option>
                                <option value="Student">Student</option>
                                <option value="Faculty">Admin/Faculty</option>
                                <option value="Admin">Admin/Faculty</option>
                                <option value="Visitor">Visitor</option>
                            </select>
                            <select class="filter-select" id="cancelledDateFilter">
                                <option value="all">All Time</option>
                                <option value="today">Today</option>
                                <option value="week">This Week</option>
                                <option value="month">This Month</option>
                            </select>
                        </div>
                    </div>

                    <!-- 3 Stat Cards -->
                    <div class="stats-cards">
                        <div class="stat-card danger">
                            <div class="stat-icon">
                                <i class="fas fa-times-circle"></i>
                            </div>
                            <div class="stat-info">
                                <h3 id="cancelled-total-count">87</h3>
                                <p>Total Cancellations</p>
                            </div>
                        </div>

                        <div class="stat-card clickable-stat active-filter" data-filter="all" data-tab="cancelled">
                            <div class="stat-icon">
                                <i class="fas fa-calendar-times"></i>
                            </div>
                            <div class="stat-info">
                                <h3 id="cancelled-filtered-count">87</h3>
                                <p id="cancelled-filtered-label">All Time</p>
                            </div>
                        </div>

                        <div class="stat-card">
                            <div class="stat-icon">
                                <i class="fas fa-calendar-day"></i>
                            </div>
                            <div class="stat-info">
                                <h3 id="cancelled-today-count">3</h3>
                                <p>Cancelled Today</p>
                            </div>
                        </div>
                    </div>

                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Name</th>
                                    <th>User Type</th>
                                    <th>Date</th>
                                    <th>Time</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr data-user-type="Student">
                                    <td>RES-201</td>
                                    <td><div class="user-cell"><span>Alex Cooper</span></div></td>
                                    <td><div class="user-type-cell"><strong>Student</strong></div></td>
                                    <td>Nov 22, 2025</td>
                                    <td>2:00 PM - 4:00 PM</td>
                                    <td><span class="badge-status cancelled">Cancelled</span></td>
                                </tr>
                                <tr data-user-type="Faculty">
                                    <td>RES-202</td>
                                    <td><div class="user-cell"><span>Michelle Turner</span></div></td>
                                    <td><div class="user-type-cell"><strong>Faculty</strong></div></td>
                                    <td>Nov 20, 2025</td>
                                    <td>10:00 AM - 12:00 PM</td>
                                    <td><span class="badge-status cancelled">Cancelled</span></td>
                                </tr>
                                <tr data-user-type="Student">
                                    <td>RES-203</td>
                                    <td><div class="user-cell"><span>Brandon Phillips</span></div></td>
                                    <td><div class="user-type-cell"><strong>Student</strong></div></td>
                                    <td>Nov 18, 2025</td>
                                    <td>3:00 PM - 5:00 PM</td>
                                    <td><span class="badge-status cancelled">Cancelled</span></td>
                                </tr>
                                <tr data-user-type="Visitor">
                                    <td>RES-204</td>
                                    <td><div class="user-cell"><span>Samantha Parker</span></div></td>
                                    <td><div class="user-type-cell"><strong>Visitor</strong></div></td>
                                    <td>Nov 17, 2025</td>
                                    <td>11:00 AM - 1:00 PM</td>
                                    <td><span class="badge-status cancelled">Cancelled</span></td>
                                </tr>
                                <tr data-user-type="Admin">
                                    <td>RES-205</td>
                                    <td><div class="user-cell"><span>Tyler Evans</span></div></td>
                                    <td><div class="user-type-cell"><strong>Admin</strong></div></td>
                                    <td>Nov 15, 2025</td>
                                    <td>1:00 PM - 3:00 PM</td>
                                    <td><span class="badge-status cancelled">Cancelled</span></td>
                                </tr>
                                <tr data-user-type="Student">
                                    <td>RES-206</td>
                                    <td><div class="user-cell"><span>Megan Collins</span></div></td>
                                    <td><div class="user-type-cell"><strong>Student</strong></div></td>
                                    <td>Nov 14, 2025</td>
                                    <td>9:00 AM - 11:00 AM</td>
                                    <td><span class="badge-status cancelled">Cancelled</span></td>
                                </tr>
                                <tr data-user-type="Faculty">
                                    <td>RES-207</td>
                                    <td><div class="user-cell"><span>Justin Stewart</span></div></td>
                                    <td><div class="user-type-cell"><strong>Faculty</strong></div></td>
                                    <td>Nov 12, 2025</td>
                                    <td>4:00 PM - 6:00 PM</td>
                                    <td><span class="badge-status cancelled">Cancelled</span></td>
                                </tr>
                                <tr data-user-type="Student">
                                    <td>RES-208</td>
                                    <td><div class="user-cell"><span>Brittany Morris</span></div></td>
                                    <td><div class="user-type-cell"><strong>Student</strong></div></td>
