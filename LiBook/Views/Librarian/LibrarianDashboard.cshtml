@{
    ViewData["Title"] = "Librarian Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - LiBook</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@100..900&family=League+Spartan:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="~/Content/librariandashboard.css" rel="stylesheet" />
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <svg class="logo-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15 15">
                    <path fill="currentColor" d="M1.082 9.939C.987 9.867 1 9.748 1 9.748L1.526 3.5s.008-.069.039-.104c.019-.022.043-.054.09-.073C2.182 3.107 5.053 1.552 6.5 3c.24.278.5.688.5 1v5.288s.006.112-.095.18a.25.25 0 0 1-.242.003c-2.226-1.114-4.711.154-5.338.487a.22.22 0 0 1-.243-.02m12.593.019c-.627-.333-3.112-1.6-5.338-.487a.25.25 0 0 1-.242-.003C7.994 9.4 8 9.288 8 9.288V4c0-.312.26-.722.5-1c1.446-1.448 4.3.107 4.827.323c.046.019.07.051.09.073c.03.035.039.104.039.104l.543 6.248s.014.119-.08.19a.22.22 0 0 1-.244.02m-4.81 2.728a.24.24 0 0 0 .118-.077a.2.2 0 0 0 .042-.109c.05-.938 1.624-1.812 4.648-.03c.077.044.166.04.242-.015c.086-.063.085-.17.085-.17v-.553s0-.077-.027-.119a.23.23 0 0 0-.093-.085c-2.025-1.315-4.586-1.898-5.885-.16a.2.2 0 0 1-.073.09c-.057.045-.126.042-.126.042h-.585s-.07.003-.126-.041a.2.2 0 0 1-.073-.09c-1.3-1.739-3.86-1.184-5.885.131a.23.23 0 0 0-.093.086c-.027.042-.027.118-.027.118v.554s-.001.107.085.17a.22.22 0 0 0 .243.015c3.023-1.782 4.598-.88 4.647.057a.2.2 0 0 0 .043.109a.24.24 0 0 0 .118.077c.721.18 1.768.25 2.722 0" />
                </svg>
                <h2 class="logo">Li<span>Book</span></h2>
            </div>
            <button class="close-btn" id="closeSidebar">
                <i class="fas fa-times"></i>
            </button>
            <button class="menu-toggle-sidebar desktop-only" id="sidebarToggleDesktop">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <nav class="sidebar-nav">
            <a href="@Url.Action("LibrarianDashboard", "Librarian")" class="nav-item active" data-page="dashboard">
                <i class="fas fa-home"></i>
                <span>Dashboard</span>
            </a>
            <a href="@Url.Action("LibrarianReservations", "Librarian")" class="nav-item" data-page="reservations">
                <i class="fas fa-calendar-check"></i>
                <span>Reservations</span>
            </a>
            <a href="@Url.Action("RoomManagement", "Librarian")" class="nav-item" data-page="rooms">
                <i class="fas fa-door-open"></i>
                <span>Room Management</span>
            </a>
            <a href="@Url.Action("LibrarianArchives", "Librarian")" class="nav-item" data-page="archives">
                <i class="fas fa-archive"></i>
                <span>Archives</span>
            </a>
        </nav>

    </aside>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navigation -->
        <header class="topbar">
            <div class="topbar-left">
                <button class="menu-toggle mobile-only" id="menuToggle">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <div class="page-header">
                <h1 class="page-title">Dashboard</h1>
                <p>Welcome back! Here's an overview of your library reservations</p>
            </div>

            <div class="topbar-actions">
                <div class="user-profile" id="userProfile">
                    <img src="https://ui-avatars.com/api/?name=Librarian&background=2c3e50&color=fff" alt="Librarian">
                    <div class="user-info">
                        <span class="user-name">LIBRARIAN</span>
                        <span class="user-role">Library Staff</span>
                    </div>
                    <i class="fas fa-chevron-down dropdown-arrow"></i>

                    <!-- User Dropdown Menu -->
                    <div class="user-dropdown" id="userDropdown">
                        @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm" }))
                        {
                            @Html.AntiForgeryToken()
                            <a href="#" class="dropdown-item logout" onclick="document.getElementById('logoutForm').submit()">
                                <i class="fas fa-sign-out-alt"></i>
                                <span>Logout</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </header>

        <!-- Dashboard Content -->
        <main class="content">
            <!-- Stats Cards -->
            <div class="stats-grid">
                <div class="stat-card blue">
                    <div class="stat-details">
                        <h3 id="todayBookings">@ViewBag.TodayBookings</h3>
                        <p>Today's Booking</p>
                    </div>
                </div>

                <div class="stat-card yellow">
                    <div class="stat-details">
                        <h3 id="roomsAvailable">@ViewBag.RoomsAvailable</h3>
                        <p>Rooms Available</p>
                    </div>
                </div>

                <div class="stat-card red">
                    <div class="stat-details">
                        <h3 id="pendingApprovals">@ViewBag.PendingApprovals</h3>
                        <p>PENDING APPROVALS</p>
                    </div>
                </div>

                <div class="stat-card dark">
                    <div class="stat-details">
                        <h3 id="totalBookings">@ViewBag.TotalBookings</h3>
                        <p>TOTAL BOOKINGS</p>
                    </div>
                </div>
            </div>

            <!-- Charts Section -->
            <div class="charts-grid">
                <div class="card chart-card">
                    <div class="card-header">
                        <h2>Peak Booking Hours</h2>
                        <div class="chart-controls">
                            <select id="chartPeriod" class="chart-select">
                                <option value="today">Today</option>
                                <option value="week">This Week</option>
                                <option value="month">This Month</option>
                            </select>
                        </div>
                    </div>
                    <div class="card-body">
                        <canvas id="bookingHoursChart"></canvas>
                    </div>
                </div>

                <div class="card chart-card">
                    <div class="card-header">
                        <h2>Bookings by User Type</h2>
                        <p class="chart-subtitle">Today's Distribution</p>
                    </div>
                    <div class="card-body">
                        <canvas id="userTypeChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Tables Section -->
            <div class="tables-grid">
                <!-- Rooms Table -->
                <div class="card table-card">
                    <div class="card-header">
                        <h2>Room Overview</h2>
                        <button class="btn-link" onclick="viewAllRooms()">View All</button>
                    </div>
                    <div class="card-body">
                        <div class="table-container">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Room Name</th>
                                        <th>Number of Booked Users</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (ViewBag.RoomOverview != null)
                                    {
                                        foreach (var room in ViewBag.RoomOverview as List<LiBook.Controllers.LibrarianController.RoomOverviewViewModel>)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="room-name">
                                                        <i class="fas fa-door-open"></i>
                                                        <span>@room.RoomName</span>
                                                    </div>
                                                </td>
                                                <td><span class="booking-count">@room.BookedUsers</span></td>
                                                <td>
                                                    <span class="status-badge @GetStatusClass(room.Status)">
                                                        @room.Status
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3" style="text-align: center; color: var(--text-light);">
                                                No room data available
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Accepted Reservations Table -->
                <div class="card table-card">
                    <div class="card-header">
                        <h2>Today's Accepted Reservations</h2>
                        <button class="btn-link" onclick="viewAllReservations()">View All</button>
                    </div>
                    <div class="card-body">
                        <div class="table-container">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Booking ID</th>
                                        <th>User Type</th>
                                        <th>Room Name</th>
                                        <th>User Name</th>
                                        <th>Time</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (ViewBag.TodaysAcceptedReservations != null)
                                    {
                                        foreach (var reservation in ViewBag.TodaysAcceptedReservations as List<LiBook.Controllers.LibrarianController.AcceptedReservationViewModel>)
                                        {
                                            <tr>
                                                <td><span class="booking-id">@reservation.BookingID</span></td>
                                                <td>
                                                    <span class="user-type @GetUserTypeClass(reservation.UserType)">
                                                        @reservation.UserType
                                                    </span>
                                                </td>
                                                <td>@reservation.RoomName</td>
                                                <td>
                                                    <div class="user-cell">
                                                        @{
                                                            var avatarColor = GetAvatarColor(reservation.UserType);
                                                            var avatarUrl = $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(reservation.UserName)}&background={avatarColor}&color=fff";
                                                        }
                                                        <img src="@avatarUrl" alt="@reservation.UserName">
                                                        <span>@reservation.UserName</span>
                                                    </div>
                                                </td>
                                                <td><span class="time-slot">@reservation.TimeSlot</span></td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" style="text-align: center; color: var(--text-light);">
                                                No accepted reservations for today
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Pass data from server to JavaScript
        const bookingHoursLabels = @Html.Raw(ViewBag.BookingHoursLabels ?? "[]");
        const bookingHoursData = @Html.Raw(ViewBag.BookingHoursData ?? "[]");
        const userTypeLabels = @Html.Raw(ViewBag.UserTypeLabels ?? "[]");
        const userTypeData = @Html.Raw(ViewBag.UserTypeData ?? "[]");
        const userTypeColors = @Html.Raw(ViewBag.UserTypeColors ?? "[]");
    </script>
    <script src="~/Scripts/librariandashboard.js"></script>
</body>
</html>

@functions {
    // Helper function to get CSS class for status badge
    public string GetStatusClass(string status)
    {
        switch (status?.ToLower())
        {
            case "available":
                return "available";
            case "unavailable":
                return "unavailable";
            case "under maintenance":
            case "maintenance":
                return "maintenance";
            default:
                return "unavailable";
        }
    }

    // Helper function to get CSS class for user type badge
    public string GetUserTypeClass(string userType)
    {
        switch (userType?.ToLower())
        {
            case "students":
            case "student":
                return "student";
            case "faculty":
                return "faculty";
            case "admin":
                return "admin";
            case "visitors":
            case "visitor":
                return "visitor";
            default:
                return "student";
        }
    }

    // Helper function to get avatar color based on user type
    public string GetAvatarColor(string userType)
    {
        switch (userType?.ToLower())
        {
            case "students":
            case "student":
                return "2c3e50";
            case "faculty":
                return "ffc107";
            case "admin":
                return "c62828";
            case "visitors":
            case "visitor":
                return "27ae60";
            default:
                return "2c3e50";
        }
    }
}