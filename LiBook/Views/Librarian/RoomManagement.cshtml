﻿@model IEnumerable<LiBook.Controllers.LibrarianController.RoomManagementViewModel>
@{
    ViewBag.Title = "Room Management";

    // Get current filter values from ViewBag
    var currentStatus = ViewBag.CurrentStatus as string ?? "all";
    var currentUserType = ViewBag.CurrentUserType as string ?? "all";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - LiBook</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@100..900&family=League+Spartan:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="~/Content/roommanagement.css" rel="stylesheet" />
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <svg class="logo-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15 15">
                    <path fill="currentColor" d="M1.082 9.939C.987 9.867 1 9.748 1 9.748L1.526 3.5s.008-.069.039-.104c.019-.022.043-.054.09-.073C2.182 3.107 5.053 1.552 6.5 3c.24.278.5.688.5 1v5.288s.006.112-.095.18a.25.25 0 0 1-.242.003c-2.226-1.114-4.711.154-5.338.487a.22.22 0 0 1-.243-.02m12.593.019c-.627-.333-3.112-1.6-5.338-.487a.25.25 0 0 1-.242-.003C7.994 9.4 8 9.288 8 9.288V4c0-.312.26-.722.5-1c1.446-1.448 4.3.107 4.827.323c.046.019.07.051.09.073c.03.035.039.104.039.104l.543 6.248s.014.119-.08.19a.22.22 0 0 1-.244.02m-4.81 2.728a.24.24 0 0 0 .118-.077a.2.2 0 0 0 .042-.109c.05-.938 1.624-1.812 4.648-.03c.077.044.166.04.242-.015c.086-.063.085-.17.085-.17v-.553s0-.077-.027-.119a.23.23 0 0 0-.093-.085c-2.025-1.315-4.586-1.898-5.885-.16a.2.2 0 0 1-.073.09c-.057.045-.126.042-.126.042h-.585s-.07.003-.126-.041a.2.2 0 0 1-.073-.09c-1.3-1.739-3.86-1.184-5.885.131a.23.23 0 0 0-.093.086c-.027.042-.027.118-.027.118v.554s-.001.107.085.17a.22.22 0 0 0 .243.015c3.023-1.782 4.598-.88 4.647.057a.2.2 0 0 0 .043.109a.24.24 0 0 0 .118.077c.721.18 1.768.25 2.722 0" />
                </svg>
                <h2 class="logo">Li<span>Book</span></h2>
            </div>
            <button class="close-btn" id="closeSidebar">
                <i class="fas fa-times"></i>
            </button>
            <button class="menu-toggle-sidebar desktop-only" id="sidebarToggleDesktop">
                <i class="fas fa-bars"></i>
            </button>
        </div>
        <nav class="sidebar-nav">
            <a href="@Url.Action("LibrarianDashboard", "Librarian")" class="nav-item" data-page="dashboard">
                <i class="fas fa-home"></i>
                <span>Dashboard</span>
            </a>
            <a href="@Url.Action("LibrarianReservations", "Librarian")" class="nav-item" data-page="reservations">
                <i class="fas fa-calendar-check"></i>
                <span>Reservations</span>
            </a>
            <a href="@Url.Action("RoomManagement", "Librarian")" class="nav-item active" data-page="rooms">
                <i class="fas fa-door-open"></i>
                <span>Room Management</span>
            </a>
            <a href="@Url.Action("LibrarianArchives", "Librarian")" class="nav-item" data-page="archives">
                <i class="fas fa-archive"></i>
                <span>Archives</span>
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navigation -->
        <header class="topbar">
            <div class="topbar-left">
                <button class="menu-toggle mobile-only" id="menuToggle">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <div class="page-header">
                <h1 class="page-title">Room Management</h1>
                <p class="page-description">Real-time monitoring and management of all library study rooms</p>
            </div>

            <div class="topbar-actions">
                <button class="icon-btn notification-btn">
                    <i class="fas fa-bell"></i>
                    <span class="badge">3</span>
                </button>
                <div class="user-profile" id="userProfile">
                    <img src="https://ui-avatars.com/api/?name=Librarian&background=2c3e50&color=fff" alt="Librarian">
                    <div class="user-info">
                        <span class="user-name">LIBRARIAN</span>
                        <span class="user-role">Library Staff</span>
                    </div>
                    <i class="fas fa-chevron-down dropdown-arrow"></i>

                    <!-- User Dropdown Menu -->
                    <div class="user-dropdown" id="userDropdown">
                        <a href="#" class="dropdown-item">
                            <i class="fas fa-user-cog"></i>
                            <span>Settings</span>
                        </a>
                        <a href="#" class="dropdown-item">
                            <i class="fas fa-question-circle"></i>
                            <span>Help & Support</span>
                        </a>
                        <div class="dropdown-divider"></div>
                        @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm" }))
                        {
                            @Html.AntiForgeryToken()
                            <a href="#" class="dropdown-item logout" id="logoutButton">
                                <i class="fas fa-sign-out-alt"></i>
                                <span>Logout</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </header>

        <!-- Dashboard Content -->
        <main class="content">
            <!-- Display error message if present -->
            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
            {
                <div class="alert alert-danger">
                    @ViewBag.ErrorMessage
                </div>
            }

            <!-- Display success/error messages from TempData -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success" style="background: #d1fae5; color: #065f46; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; border: 1px solid #10b981;">
                    <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger" style="background: #fee2e2; color: #991b1b; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; border: 1px solid #ef4444;">
                    <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
                </div>
            }

            <!-- Top Actions Bar -->
            <div class="actions-bar">
                <div class="actions-left">
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" placeholder="Search rooms..." id="searchRoomInput">
                    </div>
                    <div class="filter-group">
                        <label>Room Type:</label>
                        <select class="filter-select" id="userTypeFilter">
                            <option value="all" @(currentUserType == "all" ? "selected" : "")>All Types</option>
                            <option value="Academic" @(currentUserType == "Academic" ? "selected" : "")>Academic</option>
                            <option value="Faculty" @(currentUserType == "Faculty" ? "selected" : "")>Faculty</option>
                            <option value="Public" @(currentUserType == "Public" ? "selected" : "")>Public</option>
                        </select>
                    </div>
                    <a href="@Url.Action("RefreshRooms", "Librarian", new { status = currentStatus, userType = currentUserType })" class="btn btn-primary" id="refreshRoomsBtn">
                        <i class="fas fa-sync-alt"></i>
                        Refresh
                    </a>
                </div>
            </div>

            <!-- Quick Stats Overview -->
            <div class="quick-stats">
                <div class="stat-card stat-all @(currentStatus == "all" ? "active" : "")"
                     data-filter="all" role="button" tabindex="0"
                     onclick="filterRooms('all')">
                    <div class="stat-icon">
                        <i class="fas fa-th"></i>
                    </div>
                    <div class="stat-info">
                        <h3 id="allCount">@ViewBag.AllCount</h3>
                        <p>All Rooms</p>
                    </div>
                </div>
                <div class="stat-card stat-available @(currentStatus == "available" ? "active" : "")"
                     data-filter="available" role="button" tabindex="0"
                     onclick="filterRooms('available')">
                    <div class="stat-icon">
                        <i class="fas fa-door-open"></i>
                    </div>
                    <div class="stat-info">
                        <h3 id="availableCount">@ViewBag.AvailableCount</h3>
                        <p>Available</p>
                    </div>
                </div>
                <div class="stat-card stat-unavailable @(currentStatus == "unavailable" ? "active" : "")"
                     data-filter="unavailable" role="button" tabindex="0"
                     onclick="filterRooms('unavailable')">
                    <div class="stat-icon">
                        <i class="fas fa-ban"></i>
                    </div>
                    <div class="stat-info">
                        <h3 id="unavailableCount">@ViewBag.UnavailableCount</h3>
                        <p>Unavailable</p>
                    </div>
                </div>
                <div class="stat-card stat-maintenance @(currentStatus == "maintenance" ? "active" : "")"
                     data-filter="maintenance" role="button" tabindex="0"
                     onclick="filterRooms('maintenance')">
                    <div class="stat-icon">
                        <i class="fas fa-wrench"></i>
                    </div>
                    <div class="stat-info">
                        <h3 id="maintenanceCount">@ViewBag.MaintenanceCount</h3>
                        <p>Maintenance</p>
                    </div>
                </div>
            </div>

            <!-- Rooms Container -->
            <div class="rooms-container" id="roomsContainer">
                @if (Model != null && Model.Any())
                {
                    foreach (var room in Model)
                    {
                        // Determine status class
                        var statusClass = "available";
                        var statusText = "Available";

                        if (!string.IsNullOrEmpty(room.Status))
                        {
                            statusClass = room.Status.ToLower().Replace(" ", "-");
                            statusText = room.Status;
                        }

                        // Determine user type class and icon
                        var userTypeClass = "academic";
                        var userTypeIcon = "fa-graduation-cap";

                        if (!string.IsNullOrEmpty(room.UserType))
                        {
                            userTypeClass = room.UserType.ToLower();
                            userTypeIcon = userTypeClass == "faculty" ? "fa-chalkboard-teacher" :
                                          userTypeClass == "public" ? "fa-users" : "fa-graduation-cap";
                        }

                        var roomName = room.RoomName ?? "Unknown Room";
                        var roomType = room.RoomType ?? "Unknown Type";
                        var capacity = room.Capacity;
                        var userType = room.UserType ?? "Academic";
                        var equipment = room.Equipment ?? "Smart TV, Whiteboard";

                        <div class="room-card @statusClass" data-room-id="@room.RoomID" data-status="@statusClass" data-user-type="@userTypeClass" data-capacity="@capacity">
                            <div class="room-card-header">
                                <div class="room-info">
                                    <h3 class="room-name">@roomName</h3>
                                    <p class="room-type-label">@roomType</p>
                                </div>
                                <span class="status-badge status-@statusClass">@statusText</span>
                            </div>
                            <div class="room-card-body">
                                <div class="room-tag room-tag-@userTypeClass">
                                    <i class="fas @userTypeIcon"></i>
                                    <span>For: @userType</span>
                                </div>
                                <div class="room-details">
                                    <div class="room-detail">
                                        <i class="fas fa-users"></i>
                                        <span>@capacity people</span>
                                    </div>
                                    <div class="room-detail">
                                        <i class="fas fa-tv"></i>
                                        <span>@equipment</span>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(room.CurrentReservation))
                                {
                                    <div class="reservation-info">
                                        <div class="current-reservation">
                                            <i class="fas fa-user-clock"></i>
                                            <span><strong>Current:</strong> @room.CurrentReservation</span>
                                        </div>
                                    </div>
                                }
                                else if (!string.IsNullOrEmpty(room.NextReservation))
                                {
                                    <div class="reservation-info">
                                        <div class="next-reservation">
                                            <i class="fas fa-clock"></i>
                                            <span><strong>Next:</strong> @room.NextReservation</span>
                                        </div>
                                    </div>
                                }

                                <div class="room-actions">
                                    <!-- Updated Details Button - Opens Modal -->
                                    <button class="room-btn room-btn-primary" onclick="openRoomDetailsModal(@room.RoomID)">
                                        <i class="fas fa-info-circle"></i>
                                        <span>Details</span>
                                    </button>

                                    @if (statusClass == "available")
                                    {
                                        <button class="room-btn room-btn-success" onclick="createWalkIn(@room.RoomID)">
                                            <i class="fas fa-user-plus"></i>
                                            <span>Walk-In</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-door-closed"></i>
                        <h3>No Rooms Found</h3>
                        <p>No rooms match your current filter criteria.</p>
                    </div>
                }
            </div>
        </main>
    </div>

    <!-- Walk-In Reservation Modal -->
    <div class="modal-overlay" id="walkInModal">
        <div class="modal-container modal-walkin">
            <div class="modal-header">
                <div class="modal-title">
                    <i class="fas fa-user-plus"></i>
                    <h2>Create Walk-In Reservation</h2>
                </div>
                <button class="modal-close" onclick="closeWalkInModal()">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            @using (Html.BeginForm("CreateWalkIn", "Librarian", FormMethod.Post, new { id = "walkInForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body-walkin">
                    <!-- Info Banner -->
                    <div class="walkin-info-banner" id="walkInRoomInfo">
                        <i class="fas fa-info-circle"></i>
                        <span>Creating walk-in reservation for: <strong id="walkInRoomName">Room Name</strong></span>
                    </div>

                    <!-- Hidden Room ID -->
                    <input type="hidden" name="RoomID" id="walkInRoomId" />

                    <!-- Form Grid -->
                    <div class="walkin-form-grid">
                        <!-- Reservee Information -->
                        <div class="form-group">
                            <label for="ReserveeFirstName">
                                <i class="fas fa-user"></i> First Name <span class="required">*</span>
                            </label>
                            <input type="text" id="ReserveeFirstName" name="ReserveeFirstName" class="form-input" required placeholder="Enter first name">
                        </div>

                        <div class="form-group">
                            <label for="ReserveeLastName">
                                <i class="fas fa-user"></i> Last Name <span class="required">*</span>
                            </label>
                            <input type="text" id="ReserveeLastName" name="ReserveeLastName" class="form-input" required placeholder="Enter last name">
                        </div>

                        <div class="form-group">
                            <label for="ReserveeMiddleName">
                                <i class="fas fa-user"></i> Middle Name
                            </label>
                            <input type="text" id="ReserveeMiddleName" name="ReserveeMiddleName" class="form-input" placeholder="Optional">
                        </div>

                        <div class="form-group">
                            <label for="ReserveeSuffix">
                                <i class="fas fa-user"></i> Suffix
                            </label>
                            <input type="text" id="ReserveeSuffix" name="ReserveeSuffix" class="form-input" placeholder="Jr., Sr., III, etc.">
                        </div>

                        <div class="form-group">
                            <label for="ReserveeEmail">
                                <i class="fas fa-envelope"></i> Email Address <span class="required">*</span>
                            </label>
                            <input type="email" id="ReserveeEmail" name="ReserveeEmail" class="form-input" required placeholder="email@example.com">
                        </div>

                        <div class="form-group">
                            <label for="StudentNumber">
                                <i class="fas fa-id-card"></i> Student Number
                            </label>
                            <input type="text" id="StudentNumber" name="StudentNumber" class="form-input" placeholder="Enter student number">
                        </div>

                        <div class="form-group">
                            <label for="Program">
                                <i class="fas fa-graduation-cap"></i> Program
                            </label>
                            <input type="text" id="Program" name="Program" class="form-input" placeholder="e.g., BS Computer Science">
                        </div>

                        <!-- Booking Details -->
                        <div class="form-group">
                            <label for="BookingDate">
                                <i class="fas fa-calendar"></i> Booking Date <span class="required">*</span>
                            </label>
                            <input type="date" id="BookingDate" name="BookingDate" class="form-input" required
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                   min="@DateTime.Now.ToString("yyyy-MM-dd")">
                        </div>

                        <!-- Time Slots -->
                        <div class="form-group">
                            <label for="StartTime">
                                <i class="fas fa-clock"></i> Start Time <span class="required">*</span>
                            </label>
                            <select id="StartTime" name="StartTime" class="form-select" required>
                                <option value="">Select start time</option>
                                @for (int hour = 8; hour <= 17; hour++)
                                {
                                    for (int minute = 0; minute < 60; minute += 30)
                                    {
                                        var time = new TimeSpan(hour, minute, 0);
                                        var displayHour = hour > 12 ? hour - 12 : hour;
                                        var amPm = hour >= 12 ? "PM" : "AM";
                                        var displayTime = $"{displayHour}:{minute:00} {amPm}";
                                        <option value="@time.ToString(@"hh\:mm")">@displayTime</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="EndTime">
                                <i class="fas fa-clock"></i> End Time <span class="required">*</span>
                            </label>
                            <select id="EndTime" name="EndTime" class="form-select" required>
                                <option value="">Select end time</option>
                                @for (int hour = 8; hour <= 18; hour++)
                                {
                                    for (int minute = 0; minute < 60; minute += 30)
                                    {
                                        // Skip if hour is 18 and minute > 0 (library closes at 6 PM)
                                        if (hour == 18 && minute > 0)
                                        {
                                            // Skip this iteration
                                        }
                                        else
                                        {
                                            var time = new TimeSpan(hour, minute, 0);
                                            var displayHour = hour > 12 ? hour - 12 : hour;
                                            var amPm = hour >= 12 ? "PM" : "AM";
                                            var displayTime = $"{displayHour}:{minute:00} {amPm}";
                                            <option value="@time.ToString(@"hh\:mm")">@displayTime</option>
                                        }
                                    }
                                }
                            </select>
                        </div>

                        <!-- Purpose -->
                        <div class="form-group form-group-full">
                            <label for="Purpose">
                                <i class="fas fa-bullseye"></i> Purpose <span class="required">*</span>
                            </label>
                            <textarea id="Purpose" name="Purpose" class="form-textarea" required
                                      placeholder="Describe the purpose of this reservation (e.g., group study, meeting, presentation)"></textarea>
                        </div>

                        <!-- Additional Notes -->
                        <div class="form-group form-group-full">
                            <label for="AdditionalNotes">
                                <i class="fas fa-sticky-note"></i> Additional Notes
                                <span class="optional-badge">Optional</span>
                            </label>
                            <textarea id="AdditionalNotes" name="AdditionalNotes" class="form-textarea"
                                      placeholder="Any additional information or special requests"></textarea>
                        </div>
                    </div>

                    <!-- Form Actions -->
                    <div class="form-actions">
                        <button type="button" class="btn-walkin btn-cancel" onclick="closeWalkInModal()">
                            <i class="fas fa-times"></i> Cancel
                        </button>
                        <button type="submit" class="btn-walkin btn-submit">
                            <i class="fas fa-check"></i> Create Reservation
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/Scripts/roommanagement.js"></script>
</body>
</html>