@model IEnumerable<LiBook.Controllers.RoomManagementViewModel>

@{
    ViewBag.Title = "Room Management";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - LiBook</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@100..900&family=League+Spartan:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="~/Content/roommanagement.css" rel="stylesheet" />
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <svg class="logo-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15 15">
                    <path fill="currentColor" d="M1.082 9.939C.987 9.867 1 9.748 1 9.748L1.526 3.5s.008-.069.039-.104c.019-.022.043-.054.09-.073C2.182 3.107 5.053 1.552 6.5 3c.24.278.5.688.5 1v5.288s.006.112-.095.18a.25.25 0 0 1-.242.003c-2.226-1.114-4.711.154-5.338.487a.22.22 0 0 1-.243-.02m12.593.019c-.627-.333-3.112-1.6-5.338-.487a.25.25 0 0 1-.242-.003C7.994 9.4 8 9.288 8 9.288V4c0-.312.26-.722.5-1c1.446-1.448 4.3.107 4.827.323c.046.019.07.051.09.073c.03.035.039.104.039.104l.543 6.248s.014.119-.08.19a.22.22 0 0 1-.244.02m-4.81 2.728a.24.24 0 0 0 .118-.077a.2.2 0 0 0 .042-.109c.05-.938 1.624-1.812 4.648-.03c.077.044.166.04.242-.015c.086-.063.085-.17.085-.17v-.553s0-.077-.027-.119a.23.23 0 0 0-.093-.085c-2.025-1.315-4.586-1.898-5.885-.16a.2.2 0 0 1-.073.09c-.057.045-.126.042-.126.042h-.585s-.07.003-.126-.041a.2.2 0 0 1-.073-.09c-1.3-1.739-3.86-1.184-5.885.131a.23.23 0 0 0-.093.086c-.027.042-.027.118-.027.118v.554s-.001.107.085.17a.22.22 0 0 0 .243.015c3.023-1.782 4.598-.88 4.647.057a.2.2 0 0 0 .043.109a.24.24 0 0 0 .118.077c.721.18 1.768.25 2.722 0" />
                </svg>
                <h2 class="logo">Li<span>Book</span></h2>
            </div>
            <button class="close-btn" id="closeSidebar">
                <i class="fas fa-times"></i>
            </button>
            <button class="menu-toggle-sidebar desktop-only" id="sidebarToggleDesktop">
                <i class="fas fa-bars"></i>
            </button>
        </div>
        <nav class="sidebar-nav">
            <a href="@Url.Action("LibrarianDashboard", "Librarian")" class="nav-item" data-page="dashboard">
                <i class="fas fa-home"></i>
                <span>Dashboard</span>
            </a>
            <a href="@Url.Action("LibrarianReservations", "Librarian")" class="nav-item" data-page="reservations">
                <i class="fas fa-calendar-check"></i>
                <span>Reservations</span>
            </a>
            <a href="@Url.Action("RoomManagement", "Librarian")" class="nav-item active" data-page="rooms">
                <i class="fas fa-door-open"></i>
                <span>Room Management</span>
            </a>
            <a href="@Url.Action("LibrarianArchives", "Librarian")" class="nav-item" data-page="archives">
                <i class="fas fa-archive"></i>
                <span>Archives</span>
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navigation -->
        <header class="topbar">
            <div class="topbar-left">
                <button class="menu-toggle mobile-only" id="menuToggle">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <div class="page-header">
                <h1 class="page-title">Room Management</h1>
                <p class="page-description">Real-time monitoring and management of all library study rooms</p>
            </div>

            <div class="topbar-actions">
                <button class="icon-btn notification-btn">
                    <i class="fas fa-bell"></i>
                    <span class="badge">3</span>
                </button>
                <div class="user-profile" id="userProfile">
                    <img src="https://ui-avatars.com/api/?name=Librarian&background=2c3e50&color=fff" alt="Librarian">
                    <div class="user-info">
                        <span class="user-name">LIBRARIAN</span>
                        <span class="user-role">Library Staff</span>
                    </div>
                    <i class="fas fa-chevron-down dropdown-arrow"></i>

                    <!-- User Dropdown Menu -->
                    <div class="user-dropdown" id="userDropdown">
                        <a href="#" class="dropdown-item">
                            <i class="fas fa-user-cog"></i>
                            <span>Settings</span>
                        </a>
                        <a href="#" class="dropdown-item">
                            <i class="fas fa-question-circle"></i>
                            <span>Help & Support</span>
                        </a>
                        <div class="dropdown-divider"></div>
                        @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm" }))
                        {
                            @Html.AntiForgeryToken()
                            <a href="#" class="dropdown-item logout" id="logoutButton">
                                <i class="fas fa-sign-out-alt"></i>
                                <span>Logout</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </header>

        <!-- Dashboard Content -->
        <main class="content">
            <!-- Top Actions Bar -->
            <div class="actions-bar">
                <div class="actions-left">
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" placeholder="Search rooms..." id="searchRoomInput">
                    </div>
                    <div class="filter-group">
                        <label>Room Type:</label>
                        <select class="filter-select" id="roomTypeFilter">
                            <option value="all">All Types</option>
                            <option value="Academic">Academic</option>
                            <option value="Faculty">Faculty</option>
                            <option value="Public">Public</option>
                        </select>
                    </div>
                    <button class="btn btn-primary" id="refreshRoomsBtn">
                        <i class="fas fa-sync-alt"></i>
                        Refresh
                    </button>
                </div>
            </div>

            <!-- Quick Stats Overview -->
            <div class="quick-stats">
                <div class="stat-card stat-all active" data-filter="all" role="button" tabindex="0">
                    <div class="stat-icon">
                        <i class="fas fa-th"></i>
                    </div>
                    <div class="stat-info">
                        <h3 id="allCount">@(ViewBag.AllCount ?? 0)</h3>
                        <p>All Rooms</p>
                    </div>
                </div>
                <div class="stat-card stat-available" data-filter="available" role="button" tabindex="0">
                    <div class="stat-icon">
                        <i class="fas fa-door-open"></i>
                    </div>
                    <div class="stat-info">
                        <h3 id="availableCount">@(ViewBag.AvailableCount ?? 0)</h3>
                        <p>Available</p>
                    </div>
                </div>
                <div class="stat-card stat-unavailable" data-filter="unavailable" role="button" tabindex="0">
                    <div class="stat-icon">
                        <i class="fas fa-ban"></i>
                    </div>
                    <div class="stat-info">
                        <h3 id="unavailableCount">@(ViewBag.UnavailableCount ?? 0)</h3>
                        <p>Unavailable</p>
                    </div>
                </div>
                <div class="stat-card stat-maintenance" data-filter="maintenance" role="button" tabindex="0">
                    <div class="stat-icon">
                        <i class="fas fa-wrench"></i>
                    </div>
                    <div class="stat-info">
                        <h3 id="maintenanceCount">@(ViewBag.MaintenanceCount ?? 0)</h3>
                        <p>Maintenance</p>
                    </div>
                </div>
            </div>

            <!-- Rooms Container -->
            <div class="rooms-container" id="roomsContainer">
                @if (Model != null && Model.Any())
                {
                    foreach (var room in Model)
                    {
                        // Get actual database values
                        var roomName = room.RoomName ?? "Unknown Room";
                        var roomType = room.RoomType ?? "Academic"; // Academic, Public, or Faculty
                        var capacity = room.Capacity;
                        var availability = room.Status ?? "Available";

                        // Determine availability status class for card styling
                        var statusClass = availability.ToLower();

                        // Determine room type styling and icon
                        var roomTypeClass = roomType.ToLower();
                        var roomTypeIcon = "fa-graduation-cap"; // Default Academic

                        if (roomTypeClass == "faculty")
                        {
                            roomTypeIcon = "fa-chalkboard-teacher";
                        }
                        else if (roomTypeClass == "public")
                        {
                            roomTypeIcon = "fa-users";
                        }

                        <div class="room-card @statusClass"
                             data-room-id="@room.RoomID"
                             data-status="@statusClass"
                             data-room-type="@roomTypeClass"
                             data-capacity="@capacity">

                            <!-- Room Card Header -->
                            <div class="room-card-header">
                                <div class="room-info">
                                    <h3 class="room-name">@roomName</h3>
                                    <p class="room-availability">@availability</p>
                                </div>
                                <span class="status-badge status-@statusClass">@availability</span>
                            </div>

                            <!-- Room Card Body -->
                            <div class="room-card-body">
                                <!-- SIMPLE ELEGANT ROOM TYPE BADGE -->
                                <div class="room-tag room-tag-@roomTypeClass">
                                    <i class="fas @roomTypeIcon"></i>
                                    <span>For: @roomType</span>
                                </div>

                                <!-- Room Details -->
                                <div class="room-details">
                                    <div class="room-detail">
                                        <i class="fas fa-users"></i>
                                        <span>Capacity: @capacity</span>
                                    </div>
                                    <div class="room-detail">
                                        <i class="fas fa-door-open"></i>
                                        <span>@availability</span>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="room-actions">
                                    <button class="room-btn room-btn-primary btn-details" data-room-id="@room.RoomID">
                                        <i class="fas fa-info-circle"></i>
                                        <span>Details</span>
                                    </button>
                                    @if (statusClass == "available")
                                    {
                                        <button class="room-btn room-btn-success btn-walkin" data-room-id="@room.RoomID">
                                            <i class="fas fa-user-plus"></i>
                                            <span>Walk-In</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-door-closed"></i>
                        <h3>No Rooms Available</h3>
                        <p>There are no rooms in the system yet. Contact your administrator to add rooms.</p>
                    </div>
                }
            </div>
        </main>
    </div>

    <!-- Scripts -->
    <script src="~/Scripts/roommanagement.js"></script>
    <script>
        // Add event listeners for buttons using data attributes
        document.addEventListener('DOMContentLoaded', function() {
            // Details buttons
            var detailsBtns = document.querySelectorAll('.btn-details');
            detailsBtns.forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var roomId = parseInt(this.getAttribute('data-room-id'));
                    openRoomDetails(roomId);
                });
            });

            // Walk-in buttons
            var walkinBtns = document.querySelectorAll('.btn-walkin');
            walkinBtns.forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var roomId = parseInt(this.getAttribute('data-room-id'));
                    createWalkIn(roomId);
                });
            });
        });
    </script>
</body>
</html>
