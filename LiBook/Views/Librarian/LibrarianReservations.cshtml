﻿@{
    ViewBag.Title = "Reservations Management";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - LiBook</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@100..900&family=League+Spartan:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="~/Content/librarianreservations.css" rel="stylesheet" />
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <svg class="logo-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15 15">
                    <path fill="currentColor" d="M1.082 9.939C.987 9.867 1 9.748 1 9.748L1.526 3.5s.008-.069.039-.104c.019-.022.043-.054.09-.073C2.182 3.107 5.053 1.552 6.5 3c.24.278.5.688.5 1v5.288s.006.112-.095.18a.25.25 0 0 1-.242.003c-2.226-1.114-4.711.154-5.338.487a.22.22 0 0 1-.243-.02m12.593.019c-.627-.333-3.112-1.6-5.338-.487a.25.25 0 0 1-.242-.003C7.994 9.4 8 9.288 8 9.288V4c0-.312.26-.722.5-1c1.446-1.448 4.3.107 4.827.323c.046.019.07.051.09.073c.03.035.039.104.039.104l.543 6.248s.014.119-.08.19a.22.22 0 0 1-.244.02m-4.81 2.728a.24.24 0 0 0 .118-.077a.2.2 0 0 0 .042-.109c.05-.938 1.624-1.812 4.648-.03c.077.044.166.04.242-.015c.086-.063.085-.17.085-.17v-.553s0-.077-.027-.119a.23.23 0 0 0-.093-.085c-2.025-1.315-4.586-1.898-5.885-.16a.2.2 0 0 1-.073.09c-.057.045-.126.042-.126.042h-.585s-.07.003-.126-.041a.2.2 0 0 1-.073-.09c-1.3-1.739-3.86-1.184-5.885.131a.23.23 0 0 0-.093.086c-.027.042-.027.118-.027.118v.554s-.001.107.085.17a.22.22 0 0 0 .243.015c3.023-1.782 4.598-.88 4.647.057a.2.2 0 0 0 .043.109a.24.24 0 0 0 .118.077c.721.18 1.768.25 2.722 0" />
                </svg>
                <h2 class="logo">Li<span>Book</span></h2>
            </div>
            <button class="close-btn" id="closeSidebar">
                <i class="fas fa-times"></i>
            </button>
            <button class="menu-toggle-sidebar desktop-only" id="sidebarToggleDesktop">
                <i class="fas fa-bars"></i>
            </button>
        </div>
        <nav class="sidebar-nav">
            <a href="@Url.Action("LibrarianDashboard", "Librarian")" class="nav-item" data-page="dashboard">
                <i class="fas fa-home"></i>
                <span>Dashboard</span>
            </a>
            <a href="@Url.Action("LibrarianReservations", "Librarian")" class="nav-item active" data-page="reservations">
                <i class="fas fa-calendar-check"></i>
                <span>Reservations</span>
            </a>
            <a href="@Url.Action("RoomManagement", "Librarian")" class="nav-item" data-page="rooms">
                <i class="fas fa-door-open"></i>
                <span>Room Management</span>
            </a>
            <a href="@Url.Action("LibrarianArchives", "Librarian")" class="nav-item" data-page="archives">
                <i class="fas fa-archive"></i>
                <span>Archives</span>
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navigation -->
        <header class="topbar">
            <div class="topbar-left">
                <button class="menu-toggle mobile-only" id="menuToggle">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="page-header">
                    <h1 class="page-title">Reservations Management</h1>
                    <p>Manage and review all room reservation requests</p>
                </div>
            </div>

            <div class="topbar-actions">
                <button class="icon-btn notification-btn">
                    <i class="fas fa-bell"></i>
                    <span class="badge">3</span>
                </button>
                <div class="user-profile" id="userProfile">
                    <img src="https://ui-avatars.com/api/?name=Librarian&background=2c3e50&color=fff" alt="Librarian">
                    <div class="user-info">
                        <span class="user-name">LIBRARIAN</span>
                        <span class="user-role">Library Staff</span>
                    </div>
                    <i class="fas fa-chevron-down dropdown-arrow"></i>

                    <!-- User Dropdown Menu -->
                    <div class="user-dropdown" id="userDropdown">
                        <a href="#" class="dropdown-item">
                            <i class="fas fa-user-cog"></i>
                            <span>Settings</span>
                        </a>
                        <a href="#" class="dropdown-item">
                            <i class="fas fa-question-circle"></i>
                            <span>Help & Support</span>
                        </a>
                        <div class="dropdown-divider"></div>
                        <a href="#" class="dropdown-item logout" id="logoutLink">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Logout</span>
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <!-- Hidden logout form -->
        @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm", style = "display:none;" }))
        {
            @Html.AntiForgeryToken()
        }

        <!-- Reservations Content -->
        <main class="content">
            <!-- Tabs -->
            <div class="tabs-container">
                <div class="tabs">
                    <button class="tab active" data-tab="accepted">
                        <i class="fas fa-check-circle"></i>
                        Accepted
                        <span class="tab-badge">4</span>
                    </button>
                    <button class="tab" data-tab="cancelled">
                        <i class="fas fa-ban"></i>
                        Cancelled
                        <span class="tab-badge">4</span>
                    </button>
                </div>
            </div>

            <!-- Main Content Area with Table and Side Panel -->
            <div class="content-wrapper">
                <!-- Panel Backdrop -->
                <div class="panel-backdrop" id="panelBackdrop"></div>

                <!-- Table Card -->
                <div class="table-card" id="tableCard">
                    <div class="table-header">
                        <div class="table-controls">
                            <div class="table-search">
                                <i class="fas fa-search"></i>
                                <input type="text" id="searchInput" placeholder="Search reservations...">
                            </div>
                            <div class="filter-dropdown">
                                <select id="filterSelect" class="filter-select">
                                    <option value="all">All Users</option>
                                    <option value="az">Name: A-Z</option>
                                    <option value="za">Name: Z-A</option>
                                    <option value="student">Student Only</option>
                                    <option value="faculty">Faculty Only</option>
                                    <option value="admin">Admin Only</option>
                                    <option value="visitor">Visitor Only</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div id="tableContent">
                        <!-- Table will be rendered here by JavaScript -->
                    </div>

                    <div class="table-footer">
                        <div class="pagination">
                            <button class="pagination-btn" disabled>
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            <button class="pagination-btn active">1</button>
                            <button class="pagination-btn">2</button>
                            <button class="pagination-btn">3</button>
                            <button class="pagination-btn">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                        <div class="table-info">
                            Showing 1-8 of 8 reservations
                        </div>
                    </div>
                </div>

                <!-- Details Side Panel -->
                <div class="details-panel" id="detailsPanel">
                    <div class="panel-header">
                        <h3>Reservation Details</h3>
                        <button class="panel-close-btn" id="closePanelBtn">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>

                    <div class="panel-body" id="panelBody">
                        <div class="empty-panel">
                            <i class="fas fa-hand-pointer"></i>
                            <p>Select a reservation to view details</p>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Archive Confirmation Modal -->
    <div class="modal-overlay" id="archiveModalOverlay"></div>
    <div class="modal" id="archiveModal">
        <div class="modal-header warning">
            <div class="modal-icon warning">
                <i class="fas fa-archive"></i>
            </div>
            <h2 class="modal-title">Archive Reservation</h2>
        </div>
        <div class="modal-body">
            <p class="modal-message" id="archiveModalMessage">
                Are you sure you want to archive this reservation?
            </p>
        </div>
        <div class="modal-footer">
            <button class="btn btn-cancel" id="cancelArchiveBtn">
                <i class="fas fa-times"></i>
                Cancel
            </button>
            <button class="btn btn-confirm" id="confirmArchiveBtn">
                <i class="fas fa-check"></i>
                Archive
            </button>
        </div>
    </div>

    <!-- Cancel Confirmation Modal -->
    <div class="modal-overlay" id="cancelModalOverlay"></div>
    <div class="modal" id="cancelModal">
        <div class="modal-header danger">
            <div class="modal-icon danger">
                <i class="fas fa-ban"></i>
            </div>
            <h2 class="modal-title">Cancel Reservation</h2>
        </div>
        <div class="modal-body">
            <p class="modal-message" id="cancelModalMessage">
                Are you sure you want to cancel this reservation?
            </p>
        </div>
        <div class="modal-footer">
            <button class="btn btn-cancel" id="cancelCancelBtn">
                <i class="fas fa-times"></i>
                Cancel
            </button>
            <button class="btn btn-confirm danger" id="confirmCancelBtn">
                <i class="fas fa-check"></i>
                Cancel Reservation
            </button>
        </div>
    </div>

    <script src="~/Scripts/librarianreservations.js"></script>
</body>
</html>