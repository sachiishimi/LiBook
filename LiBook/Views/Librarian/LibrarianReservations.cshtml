@model IEnumerable<LiBook.ViewModels.ReservationViewModel>
@{
    ViewBag.Title = "Reservations Management";
    var acceptedReservations = ViewBag.AcceptedReservations as List<LiBook.Controllers.LibrarianController.ReservationViewModel> ?? new List<LiBook.Controllers.LibrarianController.ReservationViewModel>();
    var cancelledReservations = ViewBag.CancelledReservations as List<LiBook.Controllers.LibrarianController.ReservationViewModel> ?? new List<LiBook.Controllers.LibrarianController.ReservationViewModel>();

    var acceptedCount = ViewBag.AcceptedCount ?? 0;
    var cancelledCount = ViewBag.CancelledCount ?? 0;
    var allCount = ViewBag.AllCount ?? (acceptedCount + cancelledCount);
    var currentStatusFilter = ViewBag.CurrentStatusFilter ?? "all";

    // Convert times to AM/PM format
    Func<string, string> FormatTime = (time) =>
    {
        if (string.IsNullOrEmpty(time)) return "N/A";
        if (time.Contains(":"))
        {
            try
            {
                var parts = time.Split(':');
                if (parts.Length >= 2)
                {
                    int hour = int.Parse(parts[0]);
                    int minute = int.Parse(parts[1]);
                    var ampm = hour >= 12 ? "PM" : "AM";
                    var displayHour = hour % 12;
                    if (displayHour == 0) displayHour = 12;
                    return $"{displayHour}:{minute:D2} {ampm}";
                }
            }
            catch { }
        }
        return time;
    };

    // Function to get status badge class
    Func<string, string> GetStatusClass = (status) =>
    {
        switch (status.ToLower())
        {
            case "accepted":
                return "status-accepted";
            case "cancelled":
                return "status-cancelled";
            case "pending":
                return "status-pending";
            default:
                return "status-unknown";
        }
    };

    // Function to get status text
    Func<string, string> GetStatusText = (status) =>
    {
        switch (status.ToLower())
        {
            case "accepted":
                return "Accepted";
            case "cancelled":
                return "Cancelled";
            case "pending":
                return "Pending";
            default:
                return "Unknown";
        }
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - LiBook</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@100..900&family=League+Spartan:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="~/Content/librarianreservations.css" rel="stylesheet" />
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <svg class="logo-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 15 15">
                    <path fill="currentColor" d="M1.082 9.939C.987 9.867 1 9.748 1 9.748L1.526 3.5s.008-.069.039-.104c.019-.022.043-.054.09-.073C2.182 3.107 5.053 1.552 6.5 3c.24.278.5.688.5 1v5.288s.006.112-.095.18a.25.25 0 0 1-.242.003c-2.226-1.114-4.711.154-5.338.487a.22.22 0 0 1-.243-.02m12.593.019c-.627-.333-3.112-1.6-5.338-.487a.25.25 0 0 1-.242-.003C7.994 9.4 8 9.288 8 9.288V4c0-.312.26-.722.5-1c1.446-1.448 4.3.107 4.827.323c.046.019.07.051.09.073c.03.035.039.104.039.104l.543 6.248s.014.119-.08.19a.22.22 0 0 1-.244.02m-4.81 2.728a.24.24 0 0 0 .118-.077a.2.2 0 0 0 .042-.109c.05-.938 1.624-1.812 4.648-.03c.077.044.166.04.242-.015c.086-.063.085-.17.085-.17v-.553s0-.077-.027-.119a.23.23 0 0 0-.093-.085c-2.025-1.315-4.586-1.898-5.885-.16a.2.2 0 0 1-.073.09c-.057.045-.126.042-.126.042h-.585s-.07.003-.126-.041a.2.2 0 0 1-.073-.09c-1.3-1.739-3.86-1.184-5.885.131a.23.23 0 0 0-.093.086c-.027.042-.027.118-.027.118v.554s-.001.107.085.17a.22.22 0 0 0 .243.015c3.023-1.782 4.598-.88 4.647.057a.2.2 0 0 0 .043.109a.24.24 0 0 0 .118.077c.721.18 1.768.25 2.722 0" />
                </svg>
                <h2 class="logo">Li<span>Book</span></h2>
            </div>
            <button class="close-btn" id="closeSidebar">
                <i class="fas fa-times"></i>
            </button>
            <button class="menu-toggle-sidebar desktop-only" id="sidebarToggleDesktop">
                <i class="fas fa-bars"></i>
            </button>
        </div>
        <nav class="sidebar-nav">
            <a href="@Url.Action("LibrarianDashboard", "Librarian")" class="nav-item" data-page="dashboard">
                <i class="fas fa-home"></i>
                <span>Dashboard</span>
            </a>
            <a href="@Url.Action("LibrarianReservations", "Librarian")" class="nav-item active" data-page="reservations">
                <i class="fas fa-calendar-check"></i>
                <span>Reservations</span>
            </a>
            <a href="@Url.Action("RoomManagement", "Librarian")" class="nav-item" data-page="rooms">
                <i class="fas fa-door-open"></i>
                <span>Room Management</span>
            </a>
            <a href="@Url.Action("LibrarianArchives", "Librarian")" class="nav-item" data-page="archives">
                <i class="fas fa-archive"></i>
                <span>Archives</span>
            </a>
        </nav>
    </aside>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Navigation -->
        <header class="topbar">
            <div class="topbar-left">
                <button class="menu-toggle mobile-only" id="menuToggle">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="page-header">
                    <h1 class="page-title">Reservations Management</h1>
                    <p>Manage and review active room reservation requests</p>
                </div>
            </div>

            <div class="topbar-actions">
                <div class="user-profile" id="userProfile">
                    <img src="https://ui-avatars.com/api/?name=Librarian&background=2c3e50&color=fff" alt="Librarian">
                    <div class="user-info">
                        <span class="user-name">LIBRARIAN</span>
                        <span class="user-role">Library Staff</span>
                    </div>
                    <i class="fas fa-chevron-down dropdown-arrow"></i>

                    <!-- User Dropdown Menu -->
                    <div class="user-dropdown" id="userDropdown">
                        <a href="#" class="dropdown-item logout" id="logoutLink">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Logout</span>
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <!-- Hidden logout form -->
        @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm", style = "display:none;" }))
        {
            @Html.AntiForgeryToken()
        }

        <!-- Display Success/Error Messages -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            </div>
        }

        <!-- Reservations Content -->
        <main class="content">
            <!-- Tabs -->
            <div class="tabs-container">
                <div class="tabs">
                    <button class="tab active" data-tab="accepted">
                        <i class="fas fa-calendar-check"></i>
                        Accepted
                        <span class="tab-badge" id="acceptedCountBadge">@acceptedCount</span>
                    </button>
                    <button class="tab" data-tab="cancelled">
                        <i class="fas fa-ban"></i>
                        Cancelled
                        <span class="tab-badge" id="cancelledCountBadge">@cancelledCount</span>
                    </button>
                </div>
            </div>

            <!-- Main Content Area with Table and Side Panel -->
            <div class="content-wrapper">
                <!-- Panel Backdrop -->
                <div class="panel-backdrop" id="panelBackdrop"></div>

                <!-- Table Card -->
                <div class="table-card" id="tableCard">
                    <div class="table-header">
                        <div class="table-controls">
                            <div class="table-search">
                                <i class="fas fa-search"></i>
                                <input type="text" id="searchInput" placeholder="Search reservations...">
                            </div>
                            <div class="filter-dropdown">
                                <select id="filterSelect" class="filter-select">
                                    <option value="all">All Users</option>
                                    <option value="az">Name: A-Z</option>
                                    <option value="za">Name: Z-A</option>
                                    <option value="student">Student Only</option>
                                    <option value="faculty">Faculty Only</option>
                                    <option value="admin">Admin Only</option>
                                    <option value="visitor">Visitor Only</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div id="tableContent">
                        <!-- Accepted Table (initially visible) -->
                        <div class="table-wrapper" id="acceptedTable">
                            @if (acceptedReservations.Any())
                            {
                                <table class="reservations-table">
                                    <thead>
                                        <tr>
                                            <th>User</th>
                                            <th>Room</th>
                                            <th>Date</th>
                                            <th>Time</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var reservation in acceptedReservations)
                                        {
                                            <tr data-reservation-id="@reservation.ID"
                                                data-name="@reservation.ReserveeName"
                                                data-email="@reservation.Email"
                                                data-user-type="@reservation.UserType"
                                                data-room="@reservation.RoomName"
                                                data-date="@reservation.FormattedDate"
                                                data-time="@reservation.FormattedTime"
                                                data-purpose="@reservation.Purpose"
                                                data-program="@reservation.Program"
                                                data-student-number="@reservation.StudentNumber"
                                                data-status="@reservation.Status">
                                                <td>
                                                    <div class="user-cell">
                                                        <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(reservation.ReserveeName)&background=random"
                                                             alt="@reservation.ReserveeName"
                                                             class="user-avatar">
                                                        <div class="user-details">
                                                            <strong>@reservation.ReserveeName</strong>
                                                            <small>@reservation.Email</small>
                                                            <span class="user-type">@reservation.UserType</span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>@reservation.RoomName</td>
                                                <td>@reservation.FormattedDate</td>
                                                <td>@FormatTime(reservation.StartTime) - @FormatTime(reservation.EndTime)</td>
                                                <td>
                                                    <span class="status-badge @GetStatusClass(reservation.Status)">
                                                        @GetStatusText(reservation.Status)
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="empty-state">
                                    <i class="fas fa-calendar-check"></i>
                                    <h3>No Accepted Reservations</h3>
                                    <p>There are currently no accepted reservations to display.</p>
                                </div>
                            }
                        </div>

                        <!-- Cancelled Table (initially hidden) -->
                        <div class="table-wrapper" id="cancelledTable" style="display: none;">
                            @if (cancelledReservations.Any())
                            {
                                <table class="reservations-table">
                                    <thead>
                                        <tr>
                                            <th>User</th>
                                            <th>Room</th>
                                            <th>Date</th>
                                            <th>Time</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var reservation in cancelledReservations)
                                        {
                                            <tr data-reservation-id="@reservation.ID"
                                                data-name="@reservation.ReserveeName"
                                                data-email="@reservation.Email"
                                                data-user-type="@reservation.UserType"
                                                data-room="@reservation.RoomName"
                                                data-date="@reservation.FormattedDate"
                                                data-time="@reservation.FormattedTime"
                                                data-purpose="@reservation.Purpose"
                                                data-program="@reservation.Program"
                                                data-student-number="@reservation.StudentNumber"
                                                data-status="@reservation.Status">
                                                <td>
                                                    <div class="user-cell">
                                                        <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(reservation.ReserveeName)&background=random"
                                                             alt="@reservation.ReserveeName"
                                                             class="user-avatar">
                                                        <div class="user-details">
                                                            <strong>@reservation.ReserveeName</strong>
                                                            <small>@reservation.Email</small>
                                                            <span class="user-type">@reservation.UserType</span>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>@reservation.RoomName</td>
                                                <td>@reservation.FormattedDate</td>
                                                <td>@FormatTime(reservation.StartTime) - @FormatTime(reservation.EndTime)</td>
                                                <td>
                                                    <span class="status-badge @GetStatusClass(reservation.Status)">
                                                        @GetStatusText(reservation.Status)
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="empty-state">
                                    <i class="fas fa-ban"></i>
                                    <h3>No Cancelled Reservations</h3>
                                    <p>There are currently no cancelled reservations to display.</p>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="table-footer">
                        <div class="pagination">
                            <button class="pagination-btn" disabled>
                                <i class="fas fa-chevron-left"></i>
                            </button>
                            <button class="pagination-btn active">1</button>
                            <button class="pagination-btn">2</button>
                            <button class="pagination-btn">3</button>
                            <button class="pagination-btn">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </div>
                        <div class="table-info" id="tableInfo">
                            @if (acceptedReservations.Any())
                            {
                                <text>Showing 1-@acceptedReservations.Count of @acceptedReservations.Count accepted reservations</text>
                            }
                            else
                            {
                                <text>Showing 0-0 of 0 reservations</text>
                            }
                        </div>
                    </div>
                </div>

                <!-- Details Side Panel -->
                <div class="details-panel" id="detailsPanel">
                    <div class="panel-header">
                        <h3>Reservation Details</h3>
                        <button class="panel-close-btn" id="closePanelBtn">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>

                    <div class="panel-body" id="panelBody">
                        <div class="empty-panel">
                            <i class="fas fa-hand-pointer"></i>
                            <p>Select a reservation to view details</p>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Archive Confirmation Modal -->
    <div class="modal-overlay" id="archiveModalOverlay"></div>
    <div class="modal" id="archiveModal">
        @using (Html.BeginForm("ArchiveReservation", "Librarian", FormMethod.Post, new { id = "archiveForm" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="archiveReservationId" value="" />
            <div class="modal-header warning">
                <div class="modal-icon warning">
                    <i class="fas fa-archive"></i>
                </div>
                <h2 class="modal-title">Archive Reservation</h2>
            </div>
            <div class="modal-body">
                <p class="modal-message" id="archiveModalMessage">
                    Are you sure you want to archive this reservation?
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-cancel" id="cancelArchiveBtn">
                    <i class="fas fa-times"></i>
                    Cancel
                </button>
                <button type="submit" class="btn btn-confirm" id="confirmArchiveBtn">
                    <i class="fas fa-check"></i>
                    Archive
                </button>
            </div>
        }
    </div>

    <!-- Cancel Confirmation Modal -->
    <div class="modal-overlay" id="cancelModalOverlay"></div>
    <div class="modal" id="cancelModal">
        @using (Html.BeginForm("CancelReservation", "Librarian", FormMethod.Post, new { id = "cancelForm" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="cancelReservationId" value="" />
            <div class="modal-header danger">
                <div class="modal-icon danger">
                    <i class="fas fa-ban"></i>
                </div>
                <h2 class="modal-title">Cancel Reservation</h2>
            </div>
            <div class="modal-body">
                <p class="modal-message" id="cancelModalMessage">
                    Are you sure you want to cancel this reservation?
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-cancel" id="cancelCancelBtn">
                    <i class="fas fa-times"></i>
                    Cancel
                </button>
                <button type="submit" class="btn btn-confirm danger" id="confirmCancelBtn">
                    <i class="fas fa-check"></i>
                    Cancel Reservation
                </button>
            </div>
        }
    </div>

    <script src="~/Scripts/librarianreservations.js"></script>
</body>
</html>