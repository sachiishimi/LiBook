@model LiBook.Controllers.LibrarianController.RoomDetailsWithReservationsViewModel
@{
    Layout = null;
}

<!-- Room Details Modal -->
<div class="modal-overlay active" id="roomDetailsModal">
    <div class="modal-container modal-large">
        <div class="modal-header">
            <div class="modal-title">
                <i class="fas fa-door-open"></i>
                <h2>Room Details: @Model.RoomName</h2>
            </div>
            <button class="modal-close" onclick="closeRoomDetailsModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <div class="modal-body-scrollable">
            <!-- Room Info Section -->
            <div class="room-details-section">
                <div class="room-info-grid">
                    <div class="room-info-item">
                        <label><i class="fas fa-door-closed"></i> Room Type:</label>
                        <span class="room-info-value">@Model.RoomType</span>
                    </div>
                    <div class="room-info-item">
                        <label><i class="fas fa-users"></i> Capacity:</label>
                        <span class="room-info-value">@Model.Capacity people</span>
                    </div>
                    <div class="room-info-item">
                        <label><i class="fas fa-tag"></i> Status:</label>
                        <span class="status-badge status-@Model.Status.ToLower().Replace(" ", "-")">
                            @Model.Status
                        </span>
                    </div>
                    <div class="room-info-item">
                        <label><i class="fas fa-user-tag"></i> User Type:</label>
                        <span class="room-info-value">@Model.UserType</span>
                    </div>
                </div>

                <!-- Equipment List -->
                <div class="equipment-section">
                    <h4><i class="fas fa-tools"></i> Equipment</h4>
                    <div class="equipment-list">
                        @foreach (var equipment in Model.Equipment.Split(','))
                        {
                            <span class="equipment-tag">@equipment.Trim()</span>
                        }
                    </div>
                </div>

                <!-- Current/Next Reservation Info -->
                <div class="reservation-status">
                    @if (!string.IsNullOrEmpty(Model.CurrentReservation))
                    {
                        <div class="current-reservation">
                            <i class="fas fa-user-check"></i>
                            <div>
                                <strong>Currently Occupied By:</strong>
                                <p>@Model.CurrentReservation</p>
                            </div>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(Model.NextReservation))
                    {
                        <div class="next-reservation">
                            <i class="fas fa-clock"></i>
                            <div>
                                <strong>Next Reservation:</strong>
                                <p>@Model.NextReservation</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="no-reservation">
                            <i class="fas fa-calendar-times"></i>
                            <div>
                                <strong>No Upcoming Reservations</strong>
                                <p>This room is available for booking</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Upcoming Reservations Section -->
            <div class="reservations-section">
                <h3><i class="fas fa-calendar-alt"></i> Upcoming Reservations</h3>

                @if (Model.UpcomingReservations != null && Model.UpcomingReservations.Any())
                {
                    <div class="reservations-table-container">
                        <table class="reservations-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Time</th>
                                    <th>Reserved By</th>
                                    <th>User Type</th>
                                    <th>Purpose</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reservation in Model.UpcomingReservations)
                                {
                                    <tr>
                                        <td>@reservation.FormattedDate</td>
                                        <td>@reservation.TimeSlot</td>
                                        <td>
                                            <div class="reservee-info">
                                                <strong>@reservation.ReserveeName</strong>
                                                <small>@reservation.ReserveeEmail</small>
                                            </div>
                                        </td>
                                        <td>@reservation.UserType</td>
                                        <td>@reservation.Purpose</td>
                                        <td>
                                            <span class="status-badge status-@reservation.Status.ToLower()">
                                                @reservation.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="reservation-count">
                        <i class="fas fa-info-circle"></i>
                        <span>Showing @Model.UpcomingReservations.Count upcoming reservation(s)</span>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="fas fa-calendar-times"></i>
                        <h4>No Upcoming Reservations</h4>
                        <p>There are no reservations scheduled for this room at the moment.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Modal Actions -->
        <div class="modal-actions">
            @if (Model.Status == "Available")
            {
                <button class="btn btn-success" onclick="createWalkIn(@Model.RoomID)">
                    <i class="fas fa-user-plus"></i> Create Walk-In
                </button>
            }
            <button class="btn btn-secondary" onclick="closeRoomDetailsModal()">
                <i class="fas fa-times"></i> Close
            </button>
        </div>
    </div>
</div>

<style>
    .modal-large {
        max-width: 900px;
        max-height: 90vh;
        width: 90%;
    }

    .modal-body-scrollable {
        max-height: 60vh;
        overflow-y: auto;
        padding: 1.5rem;
    }

    .room-details-section {
        background: #f5f7fa;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .room-info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .room-info-item {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

        .room-info-item label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #7f8c8d;
            font-size: 0.9rem;
        }

    .room-info-value {
        font-weight: 600;
        color: #2c3e50;
    }

    .equipment-section {
        border-top: 1px solid #e8eef3;
        padding-top: 1rem;
        margin-top: 1rem;
    }

        .equipment-section h4 {
            margin-bottom: 1rem;
            color: #2c3e50;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

    .equipment-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .equipment-tag {
        background: white;
        border: 1px solid #e8eef3;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.85rem;
        color: #2c3e50;
    }

    .reservation-status {
        border-top: 1px solid #e8eef3;
        padding-top: 1rem;
        margin-top: 1rem;
    }

    .current-reservation,
    .next-reservation,
    .no-reservation {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        background: white;
        border-radius: 8px;
        border: 1px solid #e8eef3;
    }

        .current-reservation i {
            color: #c62828;
            font-size: 1.5rem;
        }

        .next-reservation i {
            color: #f39c12;
            font-size: 1.5rem;
        }

        .no-reservation i {
            color: #95a5a6;
            font-size: 1.5rem;
        }

    .reservations-section {
        margin-top: 2rem;
    }

        .reservations-section h3 {
            margin-bottom: 1rem;
            color: #2c3e50;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

    .reservations-table-container {
        overflow-x: auto;
        border: 1px solid #e8eef3;
        border-radius: 8px;
    }

    .reservations-table {
        width: 100%;
        border-collapse: collapse;
    }

        .reservations-table th {
            background: #f5f7fa;
            padding: 1rem;
            text-align: left;
            font-weight: 600;
            color: #7f8c8d;
            font-size: 0.85rem;
            text-transform: uppercase;
        }

        .reservations-table td {
            padding: 1rem;
            border-bottom: 1px solid #e8eef3;
            color: #2c3e50;
        }

        .reservations-table tbody tr:last-child td {
            border-bottom: none;
        }

        .reservations-table tbody tr:hover {
            background: #f5f7fa;
        }

    .reservee-info {
        display: flex;
        flex-direction: column;
    }

        .reservee-info small {
            color: #7f8c8d;
            font-size: 0.8rem;
        }

    .status-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .status-available,
    .status-approved {
        background: rgba(39, 174, 96, 0.2);
        color: #27ae60;
    }

    .status-pending {
        background: rgba(243, 156, 18, 0.2);
        color: #f39c12;
    }

    .status-cancelled {
        background: rgba(149, 165, 166, 0.2);
        color: #95a5a6;
    }

    .reservation-count {
        margin-top: 1rem;
        padding: 1rem;
        background: #f5f7fa;
        border-radius: 8px;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #7f8c8d;
    }

    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: #7f8c8d;
    }

        .empty-state i {
            font-size: 3rem;
            margin-bottom: 1rem;
            color: #e8eef3;
        }

        .empty-state h4 {
            margin-bottom: 0.5rem;
            color: #7f8c8d;
        }

    .modal-actions {
        padding: 1.5rem;
        border-top: 1px solid #e8eef3;
        display: flex;
        gap: 1rem;
        justify-content: flex-end;
    }

    .btn {
        padding: 0.75rem 1.5rem;
        border: none;
        border-radius: 8px;
        font-family: 'Kumbh Sans', sans-serif;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s ease;
    }

    .btn-success {
        background: #27ae60;
        color: white;
    }

    .btn-secondary {
        background: #95a5a6;
        color: white;
    }

    .btn:hover {
        opacity: 0.9;
        transform: translateY(-2px);
    }
</style>

<script>
    function closeRoomDetailsModal() {
        var modal = document.getElementById('roomDetailsModal');
        if (modal) {
            modal.remove();
        }
        document.body.style.overflow = 'auto';
    }

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            closeRoomDetailsModal();
        }
    });

    document.addEventListener('click', function (e) {
        var modal = document.getElementById('roomDetailsModal');
        if (modal && e.target === modal) {
            closeRoomDetailsModal();
        }
    });
</script>