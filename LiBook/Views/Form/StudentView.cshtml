@model LiBook.Models.StudentModel

@{
    ViewBag.Title = "Student Form";
    Layout = null;
}

<link href="~/Content/UserStyles/StudentView.css" rel="stylesheet" />
<link rel="icon" type="image/png" href="~/Content/images/qculogo.png">
<title>@ViewBag.Title</title>
<div class="student-form-container">
    <div class="form-card">
        <div class="form-header">
            <a href="@Url.Action("RoleSelection", "Home")" class="back-arrow">←</a>
            <h2>Student Form</h2>
        </div>

        @using (Html.BeginForm("Student", "Form", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-content">
                <div class="form-fields">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Last Name:</label>
                            <input type="text" name="LastName" class="form-control" required maxlength="50" />
                        </div>
                        <div class="form-group">
                            <label>First Name:</label>
                            <input type="text" name="FirstName" class="form-control" required maxlength="50" />
                        </div>
                        <div class="form-group">
                            <label>M.I.:</label>
                            <input type="text" name="MiddleInitial" class="form-control" maxlength="1" />
                        </div>
                        <div class="form-group">
                            <label>Suffix:</label>
                            <input type="text" name="Suffix" class="form-control" maxlength="10" />
                        </div>
                    </div>

                    <div class="form-row two-col">
                        <div class="form-group">
                            <label>Student Number:</label>
                            <div class="student-number-group">
                                <input type="text" name="StudentNumberPrefix" class="form-control" maxlength="2" required />
                                <span>-</span>
                                <input type="text" name="StudentNumberSuffix" class="form-control" maxlength="4" required />
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Email:</label>
                            <input type="email" name="Email" class="form-control" maxlength="254" required />
                        </div>
                    </div>

                    <div class="form-row two-col">
                        <div class="form-group">
                            <label>Purpose:</label>
                            <select name="Purpose" class="form-control" required>
                                <option value="" disabled selected>Select Purpose</option>
                                <option value="Meeting">Meeting</option>
                                <option value="Group Study">Group Study</option>
                                <option value="Discussion">Discussion</option>
                                <option value="Presentation">Presentation / Workshop</option>
                                <option value="Brainstorming">Brainstorming Session</option>
                                <option value="Interview">Interview</option>
                                <option value="Exam Preparation">Exam / Test Preparation</option>
                                <option value="Team Collaboration">Team Collaboration</option>
                                <option value="Project Planning">Project Planning</option>
                                <option value="Training">Training / Seminar</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Program:</label>
                            <select name="Program" class="form-control" required>
                                <option value="" disabled selected>Select Program</option>

                                <option value="Bachelor of Science in Accountancy">Bachelor of Science in Accountancy (BSA)</option>
                                <option value="Bachelor of Science in Entrepreneurship">Bachelor of Science in Entrepreneurship (BSEntrep)</option>
                                <option value="Bachelor of Science in Management Accounting">Bachelor of Science in Management Accounting (BSMA)</option>

                                <option value="Bachelor of Science in Electronics Engineering">Bachelor of Science in Electronics Engineering (BSECE)</option>
                                <option value="Bachelor of Science in Industrial Engineering">Bachelor of Science in Industrial Engineering (BSIE)</option>
                                <option value="Bachelor of Science in Computer Engineering">Bachelor of Science in Computer Engineering (BSCpE)</option>

                                <option value="Bachelor of Early Childhood Education">Bachelor of Early Childhood Education (BECEd)</option>

                                <option value="Bachelor of Science in Information Technology">Bachelor of Science in Information Technology (BSIT)</option>
                                <option value="Bachelor of Science in Information System">Bachelor of Science in Information System (BSIS)</option>
                                <option value="Bachelor of Science in Computer Science">Bachelor of Science in Computer Science (BSCS)</option>

                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label>Date:</label>
                            <input type="date" name="Date" class="form-control" min="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="form-group" style="grid-column: span 2;">
                            <label>Time:</label>
                            <div class="time-fields">
                                <input type="time" id="TimeStart" name="TimeStart" class="form-control" required />
                                <span style="align-self: center;">-</span>
                                <input type="time" id="TimeEnd" name="TimeEnd" class="form-control" required />
                            </div>
                        </div>

                        <div class="form-group">
                            <label>No. of Members:</label>
                            <input type="number" id="memberCount" name="NumberOfMembers" class="form-control" value="2" max="10" readonly
                                   style="background: rgba(211, 211, 211, 0.5); color: black;" />
                        </div>

                    </div>

                    <div class="form-row full">

                        <div class="form-group members-section">
                            <label>Name of members:</label>
                            <div id="membersContainer" class="members-columns">
                                <div class="members-column" id="column-1">
                                    <input type="text" name="Members[0]" class="form-control" placeholder="Member 1" required />
                                    <input type="text" name="Members[1]" class="form-control" placeholder="Member 2" required />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-row two-col-balanced">
                        <button type="button" id="addMemberBtn" class="form-group two-col">Add Member</button>
                        <button type="button" id="removeMemberBtn" class="form-group two-col">Remove Member</button>
                    </div>


                </div>

                <div class="photo-section">
                    <div class="photo-placeholder">
                        <img src="~/Content/images/students.png" />
                    </div>
                </div>
            </div>

            <button type="submit" class="btn-next" id="submitBtn">Next</button>
            <div style="clear: both;"></div>
        }
    </div>
</div>

@* Modal Partial *@
@Html.Partial("_ConfirmModal")

<script>

    // TIME INPUT VALIDATION
    const timeStart = document.getElementById('TimeStart');
    const timeEnd = document.getElementById('TimeEnd');
    const timeError = document.getElementById('timeError');

    function validateTime() {
        if (timeStart.value && timeEnd.value) {
            if (timeStart.value >= timeEnd.value) {
                alert("Start time must be before end time");
                timeEnd.value = ""; // Clear the end time
                return false;
            }
        }
        return true; //
    }

    // DYNAMICALLY ADDED MEMBER FIELDS
    const container = document.getElementById("membersContainer");
    const addBtn = document.getElementById("addMemberBtn");
    const removeBtn = document.getElementById("removeMemberBtn");
    const memberCountInput = document.getElementById("memberCount");
    const maxMembers = 10;

    let memberIndex = 2; // starts with 2
    let currentColumn = 1;

    // Add Member
    addBtn.addEventListener("click", () => {
        if (memberIndex >= maxMembers) { alert("Max 10 members."); return; }
        memberIndex++;
        memberCountInput.value = memberIndex;

        if ((memberIndex - 1) % 2 === 0) {
            currentColumn++;
            const newColumn = document.createElement("div");
            newColumn.className = "members-column";
            newColumn.id = "column-" + currentColumn;
            container.appendChild(newColumn);
        }

        const input = document.createElement("input");
        input.type = "text";
        input.name = `Members[${memberIndex}]`;
        input.className = "form-control";
        input.required = true;  // <-- makes it required
        input.placeholder = "Member " + memberIndex;
        document.getElementById("column-" + currentColumn).appendChild(input);
    });

    // Remove Member
    removeBtn.addEventListener("click", () => {
        if (memberIndex <= 2) { alert("Must have at least 2 members."); return; }

        const lastInput = document.querySelector(`#column-${currentColumn} input:last-child`);
        if (lastInput) {
            lastInput.remove();
            memberIndex--;
            memberCountInput.value = memberIndex;

            const colDiv = document.getElementById("column-" + currentColumn);
            if (colDiv.children.length === 0) { colDiv.remove(); currentColumn--; }
        }
    });

    // MODAAAAAAAAAAAAAAAAAAAAL

    // Get elements
    const modal = document.getElementById("confirmModal");
    const closeBtn = document.getElementById("closeModalBtn");
    const confirmBtn = document.getElementById("confirmSubmitBtn");
    const form = document.querySelector("form");

    // Close modal function
    function closeModal() {
        modal.style.display = "none";
    }

    // Open modal function
    function openModal(content) {
        document.getElementById("modalContent").innerHTML = content;
        modal.style.display = "flex";
    }

    // Close button
    closeBtn.addEventListener("click", closeModal);

    // Clicking outside modal box closes modal
    modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
    });

    // Intercept form submission
    form.addEventListener("submit", (e) => {
        e.preventDefault();

        if (!validateTime()) {
            return;
        }

        // Build modal content
        const last = form["LastName"].value;
        const first = form["FirstName"].value;
        const mi = form["MiddleInitial"].value;
        const suf = form["Suffix"].value;
        const studentNum = `${form["StudentNumberPrefix"].value}-${form["StudentNumberSuffix"].value}`;
        const email = form["Email"].value;
        const purpose = form["Purpose"].value;
        const program = form["Program"].value;
        const date = form["Date"].value;
        const timeStart = form["TimeStart"].value;
        const timeEnd = form["TimeEnd"].value;

        //let members = "";
        //const totalMembers = parseInt(form["NumberOfMembers"].value);
        //for (let i = 1; i <= totalMembers; i++) {
        //    members += `<li>${form[`Member${i}`].value}</li>`;
        //}

        const membersArray = Array.from(document.querySelectorAll("input[name^='Members']"))
            .map(i => i.value)

        const membersStr = membersArray.join(", ");

        const html = `
            <div class="info-row">
                <span class="info-label">Name:</span>
                <span class="info-value">${last}, ${first} ${mi ? mi + "." : ""} ${suf}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Student Number:</span>
                <span class="info-value">${studentNum}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Email:</span>
                <span class="info-value">${email}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Program:</span>
                <span class="info-value">${program}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Purpose:</span>
                <span class="info-value">${purpose}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Date:</span>
                <span class="info-value">${date}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Time:</span>
                <span class="info-value">${timeStart} - ${timeEnd}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Members (${membersArray.length}):</span>
                <span class="info-value">${membersStr}</span>
            </div>
        `;

        openModal(html);
    });

    // Confirm button submits the form
    confirmBtn.addEventListener("click", () => {
        const memberInputs = Array.from(document.querySelectorAll("input[name^='Members'][type='text']"));

        // Reindex them to be sequential: Members[0], Members[1], Members[2], etc.
        memberInputs.forEach((input, index) => {
            input.name = `Members[${index}]`;
        });

        form.action = "/Form/Student";
        form.method = "POST";
        form.submit();
    });

</script>
