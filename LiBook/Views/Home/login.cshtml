@{
    ViewBag.Title = "Login - Admin";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>

    <link href="~/Content/login.css" rel="stylesheet" />
</head>
<body>
    <div class="login-container">
        <div class="login-left">
            <div class="logo-section">
                <h1 class="logo">QCU <span>LiBook</span></h1>
                <p class="subtitle">Quezon City University Library Collaboration Room</p>
            </div>

            <form id="loginForm">
                <label for="email">EMAIL :</label>
                <input type="email" id="email" name="email" required>

                <label for="password">PASSWORD :</label>
                <input type="password" id="password" name="password" required>

                <a href="#" class="forgot-password" onclick="openForgot()">Forgot Password?</a>
                <button type="submit" class="login-btn">LOG IN</button>
            </form>

            <ul class="info-list">
                <li>Boost your productivity with dedicated study spaces.</li>
                <li>Collaborate better with the right environment.</li>
                <li>Book anytime, anywhere in just a few clicks.</li>
            </ul>
        </div>
        <div class="login-right"></div>
    </div>

    <!-- Forgot Password Modal Overlay -->
    <div class="forgot-overlay" id="forgotOverlay">

        <!-- Step 1: Email -->
        <div class="forgot-modal active" id="stepEmail">
            <h2 class="forgot-msg">To reset your password, please enter your email address.</h2>
            <h2 class="verify-msg">A verification code will be sent shortly.</h2>

            <label>Enter your registered email here:</label>
            <input type="email" id="emailInput" placeholder="Enter email">
            <span class="error-text" id="emailError">Invalid email</span>

            <div class="button-group">
                <button type="button" class="cancel-btn" onclick="closeForgot()">Cancel</button>
                <button type="button" class="main-btn" onclick="goToCode()">Send Code</button>
            </div>
        </div>

        <!-- Step 2: Code -->
        <div class="forgot-modal" id="stepCode">
            <h2>Enter the code we’ve sent to your email</h2>
            <label>Code</label>
            <div class="code-boxes">
                <input maxlength="1">
                <input maxlength="1">
                <input maxlength="1">
                <span>-</span>
                <input maxlength="1">
                <input maxlength="1">
                <input maxlength="1">
            </div>

            <!-- Timer with dynamic countdown -->
            <p class="timer">
                <span id="countdown">00:30</span>
                <span class="resend" id="resendBtn" onclick="resendCode()">Resend code</span>
            </p>

            <div class="button-group">
                <button class="cancel-btn" onclick="closeForgot()">Cancel</button>
                <button class="confirm-btn" onclick="goToNewPass()">Confirm</button>
            </div>
        </div>

        <div class="forgot-modal verify-modal" id="verifyMessage">
            <h2>A verification code will be sent shortly</h2>
        </div>


        <div class="forgot-modal" id="stepNewPassword">
            <h2>SET YOUR NEW PASSWORD</h2>

            <label for="newPassword">NEW PASSWORD:</label>
            <div class="password-container">
                <input type="password" id="newPassword" placeholder="Enter new password">
                <span class="toggle-eye" onclick="togglePassword('newPassword', this)">👁️</span>
            </div>
          
                <p class="rules-title">Password Requirements:</p>
                <ul class="rules-list">
                    <li>Must be at least 8 characters long</li>
                    <li>Must include one uppercase letter (A–Z)</li>
                    <li>Must include one lowercase letter (a–z)</li>
                    <li>Must include one number (0–9)</li>
                    <li>Must include one special character (e.g. #, $, %)</li>
                    <li>Must not contain spaces</li>
                </ul>


            <label for="confirmNewPassword">CONFIRM NEW PASSWORD:</label>
            <div class="password-container">
                <input type="password" id="confirmNewPassword" placeholder="Re-enter new password">
                <span class="toggle-eye" onclick="togglePassword('confirmNewPassword', this)">👁️</span>
            </div>

            <div class="button-group">
                <button type="button" class="cancel-btn" onclick="closeForgot()">CANCEL</button>
                <button type="button" class="confirm-btn" onclick="finishReset()">CONFIRM</button>
            </div>
        </div>


        <!-- Step 4: Success Message -->
        <div class="forgot-modal verify-modal" id="resetSuccess">
            <h2>YOUR PASSWORD HAS BEEN RESET SUCCESSFULLY.</h2>
            <h2>YOU CAN NOW LOG IN WITH YOUR NEW PASSWORD.</h2>
        </div>
    </div>

    <script src="~/Scripts/login.js"></script>
</body>
</html>
