@{
    ViewBag.Title = "Login - LiBook";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kumbh+Sans:wght@100..900&family=League+Spartan:wght@100..900&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Young+Serif&display=swap" rel="stylesheet">

    <link href="~/Content/login.css" rel="stylesheet" />
</head>
<body>
    <div class="login-container">
        <!-- Logo in top-left corner -->
        <div class="logo-corner">
            <h1 class="logo-text">Li<span>Book</span></h1>
        </div>

        <!-- Centered login card -->
        <div class="login-card">
            <h1 class="welcome-title">Welcome to <span class="brand-name">Li<span class="brand-accent">Book</span></span></h1>

            <form id="loginForm">
                <div class="input-group">
                    <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24">
                        <path fill="currentColor" d="M12 12q-1.65 0-2.825-1.175T8 8t1.175-2.825T12 4t2.825 1.175T16 8t-1.175 2.825T12 12m-8 8v-2.8q0-.85.438-1.562T5.6 14.55q1.55-.775 3.15-1.162T12 13t3.25.388t3.15 1.162q.725.375 1.163 1.088T20 17.2V20z" />
                    </svg>
                    <input type="email" id="email" name="email" placeholder="Email" required>
                </div>

                <div class="input-group password-group">
                    <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24">
                        <path fill="currentColor" d="M17 9V7c0-2.8-2.2-5-5-5S7 4.2 7 7v2c-1.7 0-3 1.3-3 3v7c0 1.7 1.3 3 3 3h10c1.7 0 3-1.3 3-3v-7c0-1.7-1.3-3-3-3M9 7c0-1.7 1.3-3 3-3s3 1.3 3 3v2H9zm4.1 8.5l-.1.1V17c0 .6-.4 1-1 1s-1-.4-1-1v-1.4c-.6-.6-.7-1.5-.1-2.1s1.5-.7 2.1-.1c.6.5.7 1.5.1 2.1" />
                    </svg>
                    <input type="password" id="password" name="password" placeholder="Password" required>
                    <span class="toggle-eye" onclick="togglePassword('password', this)">
                        <svg class="eye-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </span>
                </div>

                <a href="#" class="forgot-password" onclick="openForgot()">Forgot Password?</a>

                <button type="submit" class="login-btn">LOG IN</button>
            </form>
        </div>
    </div>

    <!-- Forgot Password Modal Overlay -->
    <div class="forgot-overlay" id="forgotOverlay">

        <!-- Step 1: Email -->
        <div class="forgot-modal active" id="stepEmail">
            <h2 class="forgot-msg">To reset your password, please enter your email address.</h2>
            <h2 class="verify-msg">A verification code will be sent shortly.</h2>

            <label>Enter your registered email here:</label>
            <input type="email" id="emailInput" placeholder="Enter email">
            <span class="error-text" id="emailError">Invalid email</span>

            <div class="button-group">
                <button type="button" class="cancel-btn" onclick="closeForgot()">Cancel</button>
                <button type="button" class="main-btn" onclick="goToCode()">Send Code</button>
            </div>
        </div>

        <!-- Step 2: Code -->
        <div class="forgot-modal" id="stepCode">
            <h2>Enter the code we've sent to your email</h2>
            <label>Code</label>
            <div class="code-boxes">
                <input maxlength="1">
                <input maxlength="1">
                <input maxlength="1">
                <span>-</span>
                <input maxlength="1">
                <input maxlength="1">
                <input maxlength="1">
            </div>

            <p class="timer">
                <span id="countdown">00:30</span>
                <span class="resend" id="resendBtn" onclick="resendCode()">Resend code</span>
            </p>

            <div class="button-group">
                <button class="cancel-btn" onclick="closeForgot()">Cancel</button>
                <button class="confirm-btn" onclick="goToNewPass()">Confirm</button>
            </div>
        </div>

        <div class="forgot-modal verify-modal" id="verifyMessage">
            <h2>A verification code will be sent shortly</h2>
        </div>

        <div class="forgot-modal" id="stepNewPassword">
            <h2>SET YOUR NEW PASSWORD</h2>

            <label for="newPassword">NEW PASSWORD:</label>
            <div class="password-container">
                <input type="password" id="newPassword" placeholder="Enter new password">
                <span class="toggle-eye" onclick="togglePassword('newPassword', this)">
                    <svg class="eye-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                </span>
            </div>

            <label for="confirmNewPassword">CONFIRM NEW PASSWORD:</label>
            <div class="password-container">
                <input type="password" id="confirmNewPassword" placeholder="Re-enter new password">
                <span class="toggle-eye" onclick="togglePassword('confirmNewPassword', this)">
                    <svg class="eye-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                </span>
            </div>

            <div class="button-group">
                <button type="button" class="cancel-btn" onclick="closeForgot()">CANCEL</button>
                <button type="button" class="confirm-btn" onclick="finishReset()">CONFIRM</button>
            </div>

            <p class="rules-title">Password Requirements:</p>
            <ul class="rules-list">
                <li id="rule-length">Must be at least 8 characters long</li>
                <li id="rule-uppercase">Must include one uppercase letter (A–Z)</li>
                <li id="rule-lowercase">Must include one lowercase letter (a–z)</li>
                <li id="rule-number">Must include one number (0–9)</li>
                <li id="rule-special">Must include one special character (e.g. #, $, %)</li>
                <li id="rule-space">Must not contain spaces</li>
            </ul>
        </div>

        <!-- Step 4: Success Message -->
        <div class="forgot-modal verify-modal" id="resetSuccess">
            <h2>YOUR PASSWORD HAS BEEN RESET SUCCESSFULLY.</h2>
            <h2>YOU CAN NOW LOG IN WITH YOUR NEW PASSWORD.</h2>
        </div>
    </div>

    <script src="~/Scripts/login.js"></script>
</body>
</html>